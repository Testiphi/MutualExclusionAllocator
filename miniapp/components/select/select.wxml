<view class="field"><view wx:if="{{label}}" class="label">{{label}}</view><button disabled="{{disabled}}" bindtap="toggle">{{selectedLabel}} ⌄</button><scroll-view wx:if="{{open}}" scroll-y="{{true}}" class="options"><button wx:for="{{options}}" wx:key="value" class="{{item.value === value ? 'selected' : ''}}" data-index="{{index}}" bindtap="choose">{{item.label}}</button></scroll-view></view>
