view,button,scroll-view{box-sizing:border-box}.field{position:relative;margin:8px 0;min-width:0;max-width:100%}.label{font-size:14px;color:#8b949e;margin-bottom:4px}button{margin:0;width:100%;padding:9px 12px;border:1px solid #30363d;border-radius:8px;background:#0d1117;color:#e6edf3;font-size:14px;line-height:1.5;text-align:left}button::after{border:0}button[disabled]{background:#161b22!important;color:#6e7681!important;border-color:#21262d!important}.options{max-height:240px;border:1px solid #30363d;border-radius:8px;background:#161b22;position:relative;z-index:5}.options button{border:0;border-radius:0;min-height:44px}.selected{background:#1f3a5f;color:#58a6ff}

.field button{display:block;width:100%!important}

.field>button{background:#0d1117!important;color:#e6edf3;border-color:#30363d}.field>button[disabled]{background:#161b22!important;color:#6e7681!important}.options button{background:transparent!important}.options .selected{background:#1f3a5f!important;color:#58a6ff}
