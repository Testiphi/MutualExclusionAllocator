@import "shared/theme.wxss";
@import "shared/functional_theme.wxss";
/* Website theme.css visual values; no shared business rules. */
page { background:#0d1117; color:#e6edf3; font-family:system-ui,'Segoe UI',Roboto,'Helvetica Neue',sans-serif; font-size:28rpx; line-height:1.5; }
view,text,button,input,scroll-view { box-sizing:border-box; }
button { width:auto; margin:0; padding:16rpx 24rpx; border:1rpx solid #30363d; border-radius:12rpx; background:#21262d; color:#e6edf3; font:inherit; font-size:26rpx; line-height:1.4; font-weight:400; }
button::after { border:0; }
button[disabled] { color:#6e7681; background:#161b22; border-color:#21262d; }
.primary { color:#fff; background:#238636; border-color:#238636; font-weight:600; }

.mirror-page input,.mirror-page textarea{width:100%;box-sizing:border-box;padding:8px 10px;background:#0d1117;color:#e6edf3;border:1px solid #30363d;border-radius:6px;font-size:14px;margin:5px 0 12px}
.mirror-page input{height:42px}.mirror-page textarea{min-height:82px}.mirror-page .actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:12px 0}
.mirror-page button{width:auto;max-width:100%;margin:0;box-sizing:border-box;font-size:14px;background:#21262d;border:1px solid #30363d;color:#e6edf3}
.mirror-page button[disabled]{opacity:.5;background:#161b22!important;color:#6e7681!important;border-color:#21262d!important}
.mirror-page .primary{background:#238636;border-color:#2ea043;color:#fff}.mirror-page .danger{background:#3a2329;border-color:#a35e60;color:#ffc3c3}
.mirror-page .error{color:#ffa198;background:#2e1c1c;padding:12px;border-left:3px solid #f85149;margin:12px 0;white-space:pre-wrap;overflow-wrap:anywhere}
.mirror-page .notice{color:#e3b341;margin:12px 0;white-space:pre-wrap;overflow-wrap:anywhere}.mirror-page .item{padding:12px;border:1px solid #30363d;border-radius:8px;margin-bottom:8px;background:#0d1117}
.mirror-page .item.is-current{background:#1f3a5f;border-color:#58a6ff}.mirror-page .item>button{display:block;width:100%;text-align:left;justify-content:flex-start}
.mirror-page .link{color:#58a6ff}.mirror-page .body{white-space:pre-wrap;overflow-wrap:anywhere}.mirror-page .filters{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end}
.mirror-page .filters>view{flex:1 1 130px;min-width:0;max-width:100%}.mirror-page .filters rp-select{min-width:100px;flex:1}.mirror-page .empty{color:#8b949e;padding:20px 0;text-align:center}
.mirror-page .pill{display:inline-block;background:#21262d;border-radius:6px;padding:3px 9px;font-size:13px}.mirror-page .timeline-item{border-top:1px solid #30363d;padding:12px 0}
.mirror-page .plain-link{padding:0;border:0;background:transparent;color:#58a6ff;min-height:24px;justify-content:flex-start;text-align:left}.mirror-page .technical{font-size:12px;border-top:1px solid #30363d;padding-top:12px;margin-top:16px}
.mirror-page .meta{font-size:13.6px;color:#8b949e;overflow-wrap:anywhere;margin:8px 0 16px}.mirror-page .page-head{border-bottom:1px solid #21262d;margin:0 -16px 16px;padding:0 16px 16px}
.mirror-page .metric-grid{display:flex;flex-wrap:wrap;gap:14px;margin:12px 0}.mirror-page .metric{flex:1 1 240px;padding:16px;border:1px solid #21262d;border-radius:8px;background:#161b22}.mirror-page .metric-values{display:flex;flex-wrap:wrap;gap:16px;margin-top:12px}.mirror-page .metric b,.mirror-page .metric-value{font-size:24px;color:#58a6ff;font-weight:700}
.mirror-page .table-scroll{width:100%;min-width:0}.mirror-page .table-row{display:flex;border-bottom:1px solid #30363d;align-items:flex-start}.mirror-page .table-cell{flex:0 0 140px;min-width:0;padding:10px;font-size:13px;white-space:normal;overflow-wrap:anywhere}.mirror-page .table-head{color:#8b949e;font-weight:500}.mirror-page .accounts-table{width:1050px}.mirror-page .accounts-table .email-cell{flex-basis:240px}.mirror-page .accounts-table .activity-cell{flex-basis:230px}.mirror-page .accounts-table .count-cell{flex-basis:80px}.mirror-page .accounts-table .actions-cell{flex-basis:220px}
.mirror-page .feature-table{width:840px}.mirror-page .stat-table{width:700px}.mirror-page .heat-table{width:830px;margin:12px 0}.mirror-page .heat-row{display:flex;width:830px}.mirror-page .heat-day{flex:0 0 48px}.mirror-page .heat-cell{flex:1;min-width:0;height:26px;border:2px solid #0d1117;border-radius:5px;font-size:10px;text-align:center;padding:2px}.mirror-page .heat-head{color:#8b949e;background:transparent}

.mirror-page .fields-grid{display:flex;flex-wrap:wrap;gap:12px}.mirror-page .fields-grid>rp-select{flex:1 1 130px;min-width:0}

.mirror-page .leaderboard-table{width:850px}.mirror-page .rank-cell{flex-basis:70px}.mirror-page .name-cell{flex-basis:160px}
