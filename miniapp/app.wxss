page { background: #0b1220; color: #e6edf8; font-size: 28rpx; }
button { width: 100%; box-sizing: border-box; padding: 20rpx 24rpx; line-height: 1.4; font-size: 28rpx; color: #e6edf8; background: #23334d; margin: 0; }
button::after { border: 0; }
button[disabled] { color: #8a9bb6; background: #1b2940; }
.primary { background: #3478ed; }
