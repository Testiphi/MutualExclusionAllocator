<view class="mirror-page"><view class="panel mirror-surface">
 <view class="page-head"><view class="page-title">{{viewTitle}}</view><view class="meta">{{tab === 'feedback' ? '仅你和站长可查看，成绩补充请使用成绩投稿。' : '查看贡献积分、质量分、正式采用奖励及站内消息。'}}</view><rp-select label="查看内容" value="{{tab}}" options="{{tabs}}" data-key="tab" bindchange="change" disabled="{{busy}}"/></view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><view class="actions"><button bindtap="load" loading="{{busy}}" disabled="{{busy}}">刷新</button><button wx:if="{{uncertain}}" bindtap="recover">核对上次操作</button></view>
 <view wx:if="{{tab === 'leaderboard' || tab === 'mine'}}" class="panel"><view class="heading">贡献榜</view><rp-select label="统计周期" value="{{period}}" options="{{periods}}" data-key="period" bindchange="change" disabled="{{busy}}"/><view class="field-label">历史月份 YYYY-MM（可选）</view><input value="{{historyMonth}}" data-key="historyMonth" bindinput="input" placeholder="例如 2026-10" maxlength="7" disabled="{{busy}}"/><button bindtap="historyPeriod" disabled="{{busy}}">查看历史月榜</button><view class="meta">{{period === 'month' ? '本月榜' : period === 'all' ? '总榜' : period}} · 更新 {{asOf}}</view>
  <scroll-view wx:if="{{tab === 'leaderboard'}}" scroll-x="{{true}}" class="table-scroll"><view class="leaderboard-table"><view class="table-row table-head"><view class="table-cell rank-cell">名次</view><view class="table-cell name-cell">贡献者</view><view class="table-cell">贡献分</view><view class="table-cell">质量分</view><view class="table-cell">采用奖励</view><view class="table-cell">有效补充</view><view class="table-cell">正式采用</view></view><view wx:for="{{items}}" wx:key="rank" class="table-row"><view class="table-cell rank-cell">{{item.rank}}</view><view class="table-cell name-cell">{{item.nickname}}</view><view class="table-cell">{{item.total}}</view><view class="table-cell">{{item.quality}}</view><view class="table-cell">{{item.adoption}}</view><view class="table-cell">{{item.effective_count}}</view><view class="table-cell">{{item.adopted_count}}</view></view></view></scroll-view><view wx:if="{{tab === 'leaderboard' && !items.length}}" class="empty">当前周期暂无贡献记录</view><view class="muted">显示前50名，边界并列全部展示；同分同名次，按北京时间结算。</view>
 </view>
 <view wx:if="{{tab === 'mine' && me}}"><view class="panel"><view class="heading">我的贡献与公开昵称</view><view class="field-label">排行榜公开昵称</view><input value="{{nickname}}" data-key="nickname" bindinput="input" maxlength="30" disabled="{{busy}}"/><button bindtap="toggleAnonymous" disabled="{{busy}}">{{anonymous ? '✓ 匿名展示' : '使用公开昵称'}}</button><view class="muted">公开榜不显示邮箱。匿名仅针对公开展示，修改昵称不改变积分。</view><button class="primary" bindtap="savePreferences" disabled="{{busy}}">保存昵称与展示设置</button><view wx:for="{{positions}}" wx:key="period" class="meta">{{item.period}} · 名次 {{item.rank}} · 贡献分 {{item.points}}</view></view><view class="panel"><view class="heading">逐项贡献</view><view wx:for="{{items}}" wx:key="id" class="item"><view>质量分 {{item.quality_points}} · 采用奖励 {{item.bonus}}</view><view class="body">{{item.sourceText}}</view><button data-id="{{item.id}}" bindtap="openContribution">查看来源与贡献调整记录</button></view><view wx:if="{{contributionDetail}}" class="panel"><view class="heading">贡献来源</view><view wx:for="{{contributionDetail.sources}}" wx:key="id" class="item"><view class="body">{{item.summary}}</view><view class="muted">{{item.statusText}}</view></view><view class="heading">调整记录</view><view wx:for="{{contributionDetail.events}}" wx:key="index" class="timeline-item"><view>{{item.timeText}} · {{item.label}}</view><view class="body">{{item.text}}</view></view></view></view></view>
 <view wx:if="{{tab === 'leaderboard' || tab === 'mine'}}" class="panel"><view class="heading">计分说明</view><view class="body">质量分由信息完整性（0–3）、证据可核验性（0–4）、数据参考价值（0–3）组成。未采用但有独立参考价值，也可以获得质量分；无新增价值的重复材料不计分。</view><view class="body">采纳后待发布奖励为10分，正式发布成功才到账。回滚撤销采用奖励；同一用户、同一目标最多一份贡献，重提只调整原记录。</view></view>
 <view wx:if="{{tab === 'announcements'}}" class="panel"><view class="actions"><button wx:if="{{preferences}}" bindtap="mute" disabled="{{busy}}">{{preferences.muted ? '恢复公告提醒' : '暂停公告提醒'}}</button></view><view wx:for="{{items}}" wx:key="id" class="item"><view class="heading">{{item.title}}</view><view class="meta">{{item.release_label}} · {{item.timeText}}{{item.ignored ? ' · 已忽略' : ''}}</view><view class="body">{{item.body}}</view><button wx:if="{{preferences}}" data-id="{{item.id}}" bindtap="dismiss" disabled="{{busy}}">{{item.ignored ? '恢复此公告提醒' : '不再提醒此公告'}}</button></view><view wx:if="{{!items.length}}" class="empty">暂无更新公告</view></view>
 <view wx:if="{{tab === 'feedback'}}"><view class="actions"><button data-view="new" bindtap="feedbackMode" disabled="{{busy}}">新建反馈</button><button data-view="mine" bindtap="feedbackMode" disabled="{{busy}}">我的反馈</button></view><view wx:if="{{feedbackView === 'new'}}" class="panel"><view class="heading">告诉我们遇到了什么问题</view><rp-select label="问题类型" value="{{form.category}}" options="{{categories}}" data-key="form.category" bindchange="input" disabled="{{busy}}"/><view class="field-label">标题</view><input value="{{form.title}}" data-key="form.title" bindinput="input" maxlength="100" disabled="{{busy}}"/><view class="field-label">问题描述</view><textarea value="{{form.description}}" data-key="form.description" bindinput="input" maxlength="6000" disabled="{{busy}}"/><view class="field-label">复现步骤（可选）</view><textarea value="{{form.steps}}" data-key="form.steps" bindinput="input" maxlength="3000" disabled="{{busy}}"/><view class="field-label">预期结果 / 实际结果（可选）</view><textarea value="{{form.expected}}" data-key="form.expected" bindinput="input" maxlength="2000" disabled="{{busy}}"/><textarea value="{{form.actual}}" data-key="form.actual" bindinput="input" maxlength="2000" disabled="{{busy}}"/><button class="primary" bindtap="createFeedback" disabled="{{busy}}">提交反馈</button></view>
  <view wx:if="{{feedbackView === 'mine'}}" class="panel"><rp-select label="状态" value="{{status}}" options="{{feedbackStatuses}}" data-key="status" bindchange="change" disabled="{{busy}}"/><input placeholder="标题搜索" value="{{q}}" data-key="q" bindinput="input" maxlength="100" disabled="{{busy}}"/><button bindtap="load" disabled="{{busy}}">查询</button><view class="meta">共 {{total || 0}} 条</view><view wx:for="{{items}}" wx:key="id" class="item"><button data-id="{{item.id}}" bindtap="openFeedback" disabled="{{busy}}">{{item.title}} · {{item.statusLabel}}{{item.unread ? ' · 未读' : ''}}</button><view class="muted">{{item.timeText}}</view></view><view wx:if="{{!items.length}}" class="empty">暂无符合条件的反馈</view></view>
  <view wx:if="{{detail}}" class="panel" id="private-feedback-detail"><view class="heading">{{detail.title}}</view><view class="meta">{{detail.statusLabel}} · {{detailVm.timeText}}</view><view class="body">{{detail.description}}</view><view class="heading">复现步骤</view><view class="body">{{detail.steps || '未填写'}}</view><view class="heading">预期 / 实际</view><view class="body">{{detail.expected || '未填写'}} / {{detail.actual || '未填写'}}</view><view wx:for="{{detailVm.events}}" wx:key="index" class="timeline-item"><view class="meta">{{item.roleLabel}} · {{item.timeText}}</view><view class="body">{{item.text}}</view></view><textarea placeholder="补充反馈" value="{{reply}}" data-key="reply" bindinput="input" maxlength="4000" disabled="{{busy}}"/><view class="actions"><button class="primary" bindtap="submitReply" disabled="{{busy}}">提交补充</button><button bindtap="markRead" disabled="{{busy}}">本条标为已读</button></view></view>
 </view>
 <view wx:if="{{tab === 'notifications'}}" class="panel"><view wx:for="{{channels}}" wx:for-item="channel" wx:key="key" class="item"><view class="heading">{{channel.label}} · {{channel.count}} 条未读</view><button wx:for="{{channel.ids}}" wx:key="*this" data-channel="{{channel.key}}" data-id="{{item}}" bindtap="openMessage">查看第 {{index + 1}} 条</button></view><view class="muted">列表刷新不自动标为已读，请在详情中确认已读。</view></view>
 <view wx:if="{{tab === 'feedback' || tab === 'announcements'}}" class="actions"><button data-delta="-1" disabled="{{offset === 0 || busy}}" bindtap="page">上一页</button><text>{{total || 0}} 条</text><button data-delta="1" disabled="{{busy || (tab === 'feedback' ? !hasNext : offset + 20 >= total)}}" bindtap="page">下一页</button></view>
</view></view>
