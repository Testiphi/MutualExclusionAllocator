<view class="mirror-page"><view class="panel mirror-surface"><view class="brand">Race<text>Pick</text></view><view class="heading">社区与消息</view><rp-select disabled="{{busy}}" value="{{tab}}" options="{{tabs}}" data-key="tab" bindchange="change"/>
 <view class="error" wx:if="{{error}}">{{error}}</view><view class="notice">{{message}}</view><button wx:if="{{uncertain}}" bindtap="recover">核对上次操作</button><button bindtap="load" loading="{{busy}}">刷新</button>
 <view wx:if="{{tab === 'leaderboard' || tab === 'mine'}}"><rp-select disabled="{{busy}}" label="统计周期" value="{{period}}" options="{{periods}}" data-key="period" bindchange="change"/><input disabled="{{busy}}" placeholder="指定月份 YYYY-MM（可选）" value="{{period}}" data-key="period" bindinput="input"/><button bindtap="load">查看周期</button></view>
 <view wx:if="{{tab === 'leaderboard'}}"><view wx:for="{{items}}" wx:key="rank" class="item"><text>{{item.rank}}. {{item.nickname}}</text><view>积分 {{item.total}} · 质量 {{item.quality}} · 采用 {{item.adoption}}</view><view class="muted">有效 {{item.effective_count}} · 已采用 {{item.adopted_count}}</view></view><view wx:if="{{!items.length}}" class="empty">当前周期暂无贡献记录</view></view>
 <view wx:if="{{tab === 'mine' && me}}"><view class="item" wx:for="{{positionFacts}}" wx:key="label"><view class="muted">{{item.label}}</view><view>{{item.value}}</view></view><view class="heading">公开昵称与匿名设置</view><input disabled="{{busy}}" value="{{nickname}}" data-key="nickname" bindinput="input" maxlength="30"/><button bindtap="toggleAnonymous">{{anonymous ? '✓ 匿名展示' : '使用公开昵称'}}</button><button bindtap="savePreferences">保存设置</button><view class="item" wx:for="{{items}}" wx:key="id"><view>质量积分 {{item.quality_points}} · 采用奖励 {{item.bonus}}</view><view>{{item.sourceText}}</view><button data-id="{{item.id}}" bindtap="openContribution">查看贡献明细与记录</button></view><view class="item" wx:for="{{contributionFacts}}" wx:key="label"><view class="muted">{{item.label}}</view><view class="body">{{item.value}}</view></view></view>
 <view wx:if="{{tab === 'announcements'}}"><button wx:if="{{preferences}}" bindtap="mute">{{preferences.muted ? '恢复公告提醒' : '暂停公告提醒'}}</button><view wx:for="{{items}}" wx:key="id" class="item"><view class="heading">{{item.title}}</view><view class="muted">{{item.release_label}}</view><view class="body">{{item.body}}</view><button wx:if="{{preferences}}" data-id="{{item.id}}" bindtap="dismiss">{{item.ignored ? '恢复此公告提醒' : '忽略此公告'}}</button></view></view>
 <view wx:if="{{tab === 'feedback'}}"><view class="heading">新建私人反馈</view><rp-select disabled="{{busy}}" label="类型" value="{{form.category}}" options="{{categories}}" data-key="form.category" bindchange="input"/><view class="field-label">标题</view><input disabled="{{busy}}" value="{{form.title}}" data-key="form.title" bindinput="input" maxlength="100"/><view class="field-label">详细说明</view><textarea disabled="{{busy}}" value="{{form.description}}" data-key="form.description" bindinput="input" maxlength="6000"/><view class="field-label">复现步骤</view><textarea disabled="{{busy}}" value="{{form.steps}}" data-key="form.steps" bindinput="input" maxlength="3000"/><view class="field-label">预期结果</view><textarea disabled="{{busy}}" value="{{form.expected}}" data-key="form.expected" bindinput="input" maxlength="2000"/><view class="field-label">实际结果</view><textarea disabled="{{busy}}" value="{{form.actual}}" data-key="form.actual" bindinput="input" maxlength="2000"/><button class="primary" bindtap="createFeedback" disabled="{{busy}}">提交私人反馈</button>
 <rp-select disabled="{{busy}}" label="处理状态" value="{{status}}" options="{{feedbackStatuses}}" data-key="status" bindchange="change"/><input disabled="{{busy}}" placeholder="搜索反馈" value="{{q}}" data-key="q" bindinput="input"/><button bindtap="load">查询</button><button wx:for="{{items}}" wx:key="id" class="item" data-id="{{item.id}}" bindtap="openFeedback">{{item.title}} · {{item.statusLabel}}{{item.unread ? ' · 未读' : ''}}</button>
 <view wx:if="{{detail}}" class="panel"><view class="heading">{{detail.title}} · {{detail.statusLabel}}</view><view class="body">{{detail.description}}</view><view class="body">复现：{{detail.steps}}</view><view class="body">预期：{{detail.expected}}</view><view class="body">实际：{{detail.actual}}</view><view wx:for="{{detail.events}}" wx:key="revision" class="item"><view>{{item.actor_role}} · {{item.created_at}}</view><view class="body">{{item.message}}</view></view><textarea disabled="{{busy}}" placeholder="补充反馈" value="{{reply}}" data-key="reply" bindinput="input" maxlength="4000"/><button bindtap="submitReply">提交补充</button><button bindtap="markRead">本条标为已读</button></view></view>
 <view wx:if="{{tab === 'notifications'}}"><view class="item" wx:for="{{channels}}" wx:for-item="channel" wx:key="key"><view>{{channel.label}} · {{channel.count}} 条未读</view><button wx:for="{{channel.ids}}" wx:key="*this" data-channel="{{channel.key}}" data-id="{{item}}" bindtap="openMessage">查看第 {{index + 1}} 条</button></view><view class="muted">打开列表不会自动标为已读，请在详情中确认已读。</view></view>
 <view wx:if="{{tab === 'feedback' || tab === 'announcements'}}" class="actions"><button data-delta="-1" disabled="{{offset === 0}}" bindtap="page">上一页</button><text>{{total || 0}} 条</text><button data-delta="1" bindtap="page">下一页</button></view>
</view></view>
