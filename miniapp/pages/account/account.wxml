<view class="mirror-page"><view class="panel mirror-surface">
 <view class="page-title">{{actor ? '个人中心' : title + ' RacePick'}}</view>
 <view wx:if="{{actor}}" class="panel"><view class="heading">{{actor.email}}</view><view class="meta">{{actor.role === 'superadmin' ? '超级管理员' : actor.role === 'admin' ? '管理员' : '玩家'}} · {{actor.verified ? '邮箱已验证' : '邮箱待验证'}}</view><view class="actions"><button bindtap="back">返回主页车库</button><button wx:if="{{!restricted}}" data-page="submissions" bindtap="navigate">投稿 / 我的记录</button><button wx:if="{{!restricted}}" data-page="community" bindtap="navigate">贡献 / 消息 / 反馈</button><button wx:if="{{!restricted || bindingAcceptance}}" class="danger" bindtap="logout">退出当前账号</button></view></view>
 <view wx:if="{{actor && wechatBinding}}" class="panel">
  <view class="heading">微信绑定</view>
  <view class="meta">{{wechatBinding.bound ? '已绑定微信' : '尚未绑定微信'}}</view>
  <button wx:if="{{!wechatConfirm}}" bindtap="chooseWechatBinding" disabled="{{busy || recoverable}}">{{wechatBinding.bound ? '解绑微信' : '绑定当前微信'}}</button>
  <view wx:if="{{wechatConfirm}}">
   <view class="field-label">请输入 RacePick 账号密码确认{{wechatConfirm === 'wechat-unbind' ? '解绑' : '绑定'}}</view>
   <input password="{{true}}" value="{{wechatPassword}}" data-key="wechatPassword" bindinput="input" maxlength="128" disabled="{{busy}}"/>
   <button bindtap="submitWechatBinding" loading="{{busy}}" disabled="{{busy}}">{{wechatConfirm === 'wechat-unbind' ? '确认解绑' : '确认绑定'}}</button>
   <button bindtap="cancelWechatBinding" disabled="{{busy}}">取消</button>
  </view>
 </view>
 <view wx:if="{{!actor}}" class="actions"><button data-mode="login" bindtap="chooseMode" disabled="{{busy}}">登录</button><button wx:if="{{!restricted || registration}}" data-mode="register" bindtap="chooseMode" disabled="{{busy}}">注册</button><button wx:if="{{!restricted}}" data-mode="forgot-password" bindtap="chooseMode" disabled="{{busy}}">忘记密码</button></view>
 <view wx:if="{{registration && !actor}}" class="actions"><button data-mode="verify-email" bindtap="chooseMode" disabled="{{busy}}">验证邮箱</button><button data-mode="resend-verification" bindtap="chooseMode" disabled="{{busy}}">重发验证邮件</button></view>
 <view wx:if="{{!restricted}}" class="actions"><button class="plain-link" bindtap="toggleMore">{{moreOpen ? '收起更多账号操作' : '验证邮件 / 邀请码 / 更多操作'}}</button></view><view wx:if="{{moreOpen && !restricted}}" class="actions"><button data-mode="resend-verification" bindtap="chooseMode">重发验证邮件</button><button data-mode="verify-email" bindtap="chooseMode">验证邮箱</button><button data-mode="reset-password" bindtap="chooseMode">重置密码</button><button wx:if="{{actor}}" data-mode="redeem-invitation" bindtap="chooseMode">兑换管理员邀请</button><button wx:if="{{actor}}" data-mode="reauth" bindtap="chooseMode">再次验证密码</button></view>
 <view wx:if="{{!actor || mode === 'redeem-invitation' || mode === 'reauth' || mode === 'reset-password' || mode === 'verify-email' || mode === 'resend-verification'}}" class="panel"><view class="heading">{{title}}</view>
 <view wx:if="{{mode === 'register' || mode === 'login' || mode === 'resend-verification' || mode === 'forgot-password'}}"><view class="field-label">邮箱{{registration && mode !== 'login' ? '（仅限 .test）' : ''}}</view><input value="{{email}}" data-key="email" bindinput="input" maxlength="254" disabled="{{busy}}"/></view>
 <view wx:if="{{mode === 'register' || mode === 'login' || mode === 'reset-password' || mode === 'reauth'}}"><view class="field-label">密码{{mode === 'register' || mode === 'reset-password' ? '（12–128位）' : ''}}</view><input password="{{true}}" value="{{password}}" data-key="password" bindinput="input" maxlength="128" disabled="{{busy}}"/></view>
 <view wx:if="{{mode === 'register' || mode === 'reset-password'}}"><view class="field-label">确认密码</view><input password="{{true}}" value="{{passwordConfirm}}" data-key="passwordConfirm" bindinput="input" maxlength="128" disabled="{{busy}}"/></view><view wx:if="{{mode === 'verify-email' || mode === 'reset-password'}}"><view class="field-label">{{registration ? '粘贴隔离收件箱中的完整验证链接' : '邮件链接中的一次性验证码'}}</view><input password="{{registration}}" value="{{token}}" data-key="token" bindinput="input" maxlength="500" disabled="{{busy}}"/></view>
 <view wx:if="{{(mode === 'register' && !registration) || mode === 'redeem-invitation'}}"><view class="field-label">邀请码{{mode === 'register' ? '（可选）' : ''}}</view><input value="{{invite_code}}" data-key="invite_code" bindinput="input" disabled="{{busy}}"/></view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{title}}</button></view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><button wx:if="{{recoverable}}" bindtap="recover">查询上次操作结果</button>
</view></view>
