<view class="mirror-page"><view class="mirror-surface panel"><view class="brand">Race<text>Pick</text></view><view class="heading">账号与个人中心</view>
 <view wx:if="{{actor}}" class="panel"><view>{{actor.email}}</view><view class="muted">{{actor.role === 'superadmin' ? '超级管理员' : actor.role === 'admin' ? '管理员' : '玩家'}}</view><button bindtap="logout">退出当前账号</button></view>
 <rp-select label="账号操作" value="{{mode}}" options="{{options}}" bindchange="changeMode" />
 <view class="heading">{{title}}</view>
 <view wx:if="{{mode === 'register' || mode === 'login' || mode === 'resend-verification' || mode === 'forgot-password'}}"><view class="field-label">邮箱</view><input value="{{email}}" data-key="email" bindinput="input" maxlength="254" /></view>
 <view wx:if="{{mode === 'register' || mode === 'login' || mode === 'reset-password' || mode === 'reauth'}}"><view class="field-label">密码{{mode === 'register' || mode === 'reset-password' ? '（12–128位）' : ''}}</view><input password="{{true}}" value="{{password}}" data-key="password" bindinput="input" maxlength="128" /></view>
 <view wx:if="{{mode === 'verify-email' || mode === 'reset-password'}}"><view class="field-label">邮件链接中的一次性验证码</view><input value="{{token}}" data-key="token" bindinput="input" maxlength="500" /></view>
 <view wx:if="{{mode === 'register' || mode === 'redeem-invitation'}}"><view class="field-label">邀请码{{mode === 'register' ? '（可选）' : ''}}</view><input value="{{invite_code}}" data-key="invite_code" bindinput="input" /></view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
 <view class="actions"><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{title}}</button><button wx:if="{{recoverable}}" bindtap="recover">查询上次操作结果</button><button bindtap="back">返回主页</button></view>
</view></view>
