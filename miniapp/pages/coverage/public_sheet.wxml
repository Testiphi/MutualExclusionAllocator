 <view class="public-score">
  <view class="public-header">
   <button class="public-back" bindtap="publicBack">← 返回选车助手</button>
   <view class="public-title">擂台成绩表</view>
   <view class="public-header-note">空白格暂无成绩。</view>
  </view>
  <view class="public-main">
   <view class="public-tabs">
    <button class="{{publicMode === 'scores' ? 'current' : ''}}" data-mode="scores" bindtap="publicTab">成绩表</button>
    <button class="{{publicMode === 'videos' ? 'current' : ''}}" data-mode="videos" bindtap="publicTab">跑法参考</button>
   </view>
   <view wx:if="{{publicMode === 'scores'}}" class="public-toolbar">
    <rp-select variant="score" label="服别" options="{{publicServers}}" value="{{scoreServer}}" data-key="scoreServer" bindchange="publicFilter"/>
    <rp-select variant="score" label="大地图" options="{{scoreMaps}}" value="{{scoreMap}}" data-key="scoreMap" bindchange="publicFilter"/>
    <rp-select variant="score" label="跑法" options="{{publicRuns}}" value="{{scoreRun}}" data-key="scoreRun" bindchange="publicFilter"/>
    <view class="public-field">
     <view>车辆列搜索</view>
     <input value="{{scoreSearch}}" maxlength="80" data-key="scoreSearch" bindinput="publicSearch" bindconfirm="publicRefresh" confirm-type="search"/>
    </view>
    <checkbox-group wx:if="{{scoreServer === 'global'}}" class="public-check score-oc" data-key="scoreOc" bindchange="publicToggle">
     <label><checkbox value="oc" checked="{{scoreOc}}" color="#58a6ff"/>OC超频</label>
    </checkbox-group>
    <button class="public-refresh" bindtap="publicRefresh">查询 / 刷新</button>
   </view>
   <view wx:else class="public-toolbar">
    <rp-select variant="score" label="服别" options="{{publicServers}}" value="{{referenceServer}}" data-key="referenceServer" bindchange="publicFilter"/>
    <view class="public-field">
     <view>地图搜索</view>
     <input value="{{mapQuery}}" maxlength="80" data-key="mapQuery" bindinput="publicSearch" confirm-type="search"/>
    </view>
    <view class="public-field">
     <view>车辆搜索</view>
     <input value="{{carQuery}}" maxlength="80" data-key="carQuery" bindinput="publicSearch" confirm-type="search"/>
    </view>
    <checkbox-group class="public-check" data-key="referenceOnly" bindchange="publicToggle">
     <label>只看有视频的格子<checkbox value="only" checked="{{referenceOnly}}" color="#58a6ff"/></label>
    </checkbox-group>
   </view>
   <view wx:if="{{publicMode === 'scores'}}" class="public-legend">{{scoreOc ? 'OC超频' : '非OC'}}</view>
   <view wx:else class="public-reference-hint">点数字查看视频。</view>
   <view wx:if="{{publicBusy}}" class="public-status" aria-role="status">正在读取{{publicMode === 'scores' ? '公开成绩' : '跑法参考'}}…</view>
   <view wx:if="{{publicError}}" class="public-status" aria-role="status">{{publicError}} <button bindtap="loadPublicRetry">重试</button></view>
   <view wx:if="{{publicSheet}}" class="public-summary">{{publicSheet.summary}}</view>
   <scroll-view wx:if="{{publicSheet.rows.length && publicSheet.columns.length}}" class="public-scroll"
     scroll-x="{{true}}" scroll-y="{{true}}" style="height:calc({{publicMode === 'scores' && scoreTier === '高手' ? 46 : 40}}px + {{publicSheet.rows.length}} * 36px)"
     aria-label="{{publicMode === 'scores' ? '成绩覆盖表，可横向与纵向滚动' : '跑法参考表，可横向与纵向滚动'}}">
    <view class="public-grid">
     <view class="public-row public-grid-head {{publicMode === 'scores' && scoreTier === '高手' ? 'with-stars' : ''}}">
      <view class="grid-index">#</view>
      <view class="grid-map">大地图</view>
      <view class="grid-track">小地图{{publicMode === 'scores' && scoreRun === 'special' ? ' / 跑法' : ''}}</view>
      <view wx:for="{{publicSheet.columns}}" wx:key="id" class="grid-car">
       <text>{{item.id}}</text>
       <rp-select wx:if="{{item.options.length}}" variant="star" aria-label="{{item.id}} 星级"
         options="{{item.options}}" value="{{item.stars}}" data-car="{{item.id}}" bindchange="publicSelectStar"/>
       <text wx:elif="{{item.note}}" class="grid-star-note">{{item.note}}</text>
      </view>
     </view>
     <view wx:for="{{publicSheet.rows}}" wx:for-item="row" wx:key="id" class="public-row">
      <view class="grid-index">{{row.id + 1}}</view>
      <view class="grid-map">{{row.big}}</view>
      <view class="grid-track">{{row.small}}</view>
      <view wx:for="{{row.cells}}" wx:key="id" class="grid-car {{item.text ? 'grid-filled' : 'grid-empty'}}">
       <button wx:if="{{item.text && publicMode === 'videos'}}" class="public-video-cell"
        data-row="{{row.id}}" data-car="{{item.id}}" bindtap="publicOpenVideos" aria-label="{{row.small}} · {{item.id}} · {{item.text}}视频">{{item.text}}</button>
       <text wx:elif="{{item.text}}">{{item.text}}</text>
      </view>
     </view>
    </view>
   </scroll-view>
   <view wx:if="{{publicSheet && (!publicSheet.rows.length || !publicSheet.columns.length)}}" class="public-summary">当前列或地图没有结果，请调整筛选。</view>
   <view wx:if="{{publicSheet}}" class="public-paging">
    <button data-delta="-1" bindtap="publicPage" disabled="{{!publicSheet.offset || publicBusy}}">上一组车辆</button>
    <text>{{publicSheet.total ? (publicSheet.offset + 1) + '–' + (publicSheet.offset + publicSheet.columns.length) + ' / ' + publicSheet.total + '列' : '0列'}}</text>
    <button data-delta="1" bindtap="publicPage" disabled="{{publicSheet.offset + publicSheet.limit >= publicSheet.total || publicBusy}}">下一组车辆</button>
   </view>
   <scroll-view wx:if="{{publicMode === 'scores'}}" class="public-sheets" scroll-x="{{true}}" aria-label="工作表">
    <view class="public-sheet-list">
     <button wx:for="{{scoreSheets}}" wx:key="label" data-index="{{index}}" bindtap="publicSelectSheet"
      class="{{item.zone === scoreZone && item.tier === scoreTier ? 'current' : ''}}">{{item.label}}</button>
    </view>
   </scroll-view>
  </view>
 </view>
