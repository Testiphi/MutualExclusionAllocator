<view class="mirror-page"><view class="panel mirror-surface"><view class="brand">Race<text>Pick</text></view><view class="heading">擂台成绩表 <text class="tag">新功能</text></view>
 <view class="filters"><rp-select label="服别" value="{{server}}" options="{{servers}}" data-key="server" bindchange="change"/><rp-select label="区域" value="{{zone}}" options="{{zones}}" data-key="zone" disabled="{{server === 'global'}}" bindchange="change"/><rp-select label="档位" value="{{tier}}" options="{{tiers}}" data-key="tier" disabled="{{server === 'global'}}" bindchange="change"/><rp-select label="跑法" value="{{route}}" options="{{routes}}" data-key="route" bindchange="change"/></view>
 <rp-select label="地图" value="{{big}}" options="{{bigOptions}}" data-key="big" bindchange="change"/><rp-select label="星级" value="{{stars}}" options="{{starOptions}}" data-key="stars" bindchange="change"/>
 <input value="{{q}}" bindinput="input" placeholder="搜索车辆"/><view class="actions"><button bindtap="load" loading="{{busy}}">查询 / 刷新</button><button data-key="gaps" bindtap="toggle">{{gaps ? '✓ ' : ''}}仅看缺成绩</button><button wx:if="{{server === 'global'}}" data-key="oc" bindtap="toggle">{{oc ? '✓ OC' : '普通车辆'}}</button></view>
 <view wx:if="{{matrix}}" class="muted">积分 {{matrix.access.points}} · 有效 {{matrix.access.valid}} · 高质量 {{matrix.access.high}} · 权益等级 {{matrix.access.level}}</view>
 <view class="error" wx:if="{{error}}">{{error}}</view><view class="notice">{{message}}</view><button wx:if="{{uncertain}}" bindtap="recover">核对上次操作</button>
 <scroll-view wx:if="{{matrix}}" scroll-x="{{true}}" class="score-scroll"><view class="score-table"><view class="score-row score-header"><view class="map-cell">地图 / 跑法</view><view wx:for="{{columns}}" wx:key="car" class="score-cell"><view>{{item.car}}</view><view class="muted">{{item.title}}</view><rp-select wx:if="{{tier === '高手'}}" value="{{item.stars}}" options="{{item.starOptions}}" data-car="{{item.car}}" bindchange="columnStars"/></view></view><view wx:for="{{matrix.rows}}" wx:for-item="row" wx:key="index" class="score-row"><view class="map-cell">{{row.big}}<view>{{row.small}}</view><view class="muted">{{row.route}}</view></view><button wx:for="{{row.cells}}" wx:key="key" class="score-cell {{item.visibility === 'locked' ? 'locked' : ''}}" data-row="{{row.index}}" data-column="{{item.index}}" bindtap="pick">{{item.display}}</button></view></view></scroll-view>
 <view wx:if="{{matrix}}" class="actions"><button data-delta="-1" disabled="{{offset === 0}}" bindtap="page">上一组车辆</button><text>{{offset + 1}} / {{matrix.column_total}}</text><button data-delta="1" disabled="{{offset + 48 >= matrix.column_total}}" bindtap="page">下一组车辆</button></view>
 <view wx:if="{{picked}}" class="panel"><view>{{picked.map}}</view><view>{{picked.car}} · {{picked.display}}</view><view class="muted">{{picked.status === 'empty' ? '尚无收录成绩' : picked.value === null ? '此成绩尚未解锁' : '运行成绩参考；不在表内插值或估算'}}</view><view class="actions"><button bindtap="contribute">为此目标投稿</button><button wx:if="{{actor && matrix.access.level === 1 && !matrix.access.chosen}}" bindtap="choose">选择此地图权益</button></view></view>
</view></view>
