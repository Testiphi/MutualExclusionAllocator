<template name="video-links">
 <view wx:if="{{entry.videoCount}}" class="route-video-group {{section === 'rows' ? 'track-video-group' : ''}}">
  <button wx:if="{{entry.videoCount > 1}}" class="top-videos-toggle" data-section="{{section}}" data-index="{{rowIndex}}" data-car="{{entry.car}}" bindtap="toggleVideoLinks">{{entry.videosOpen ? '▾' : '▸'}} 跑法视频 {{entry.videoCount}}</button>
  <button wx:for="{{entry.visibleVideos}}" wx:for-item="video" wx:key="id" class="top-video-link" data-section="{{section}}" data-index="{{rowIndex}}" data-car="{{entry.car}}" data-video-id="{{video.id}}" bindtap="openVideoLink">{{video.title}}</button>
 </view>
</template>
<view class="page home-page">
 <view class="shell">
  <view class="home-heading"><view class="brand">Race<text class="brand-pick">Pick</text></view><view class="heading-title">擂台选车助手</view></view>
  <view class="subtitle">{{subtitle}}</view>
  <view wx:if="{{planId}}" class="notice">{{conflictAcceptance ? 'W3冲突验收准备' : formalWriteCandidate ? '正式云保存验收工程' : writeAcceptance ? 'W1/W2写验收工程' : readbackAcceptance ? '已保存车库只读复核' : '只读验收工程'}}：{{buildId}}<button bindtap="copyAcceptanceReport">复制验收报告</button></view>
  <view wx:if="{{publicCoverage || (ready && !accountRestricted)}}" class="coverage-entry"><view><view class="coverage-entry-title">擂台成绩表 <text class="coverage-entry-new">新功能</text></view><view class="coverage-entry-description">{{publicCoverage ? '查看国服、国际服各图参考成绩' : '查看各图参考成绩，补充缺失记录'}}</view></view><button class="coverage-entry-link" data-page="coverage" bindtap="navigate">查看成绩表 →</button></view>
  <view wx:if="{{ready}}" class="account-panel"><view class="account-heading">{{actor ? '已登录 · ' + (actor.role === 'superadmin' ? '超级管理员' : actor.role === 'admin' ? '管理员' : '玩家') : '游客 · 资料保存在本机'}}</view><view wx:if="{{!actor}}" class="account-actions"><button disabled="{{!accountAvailable}}" class="account-primary" data-page="account" data-mode="login" bindtap="navigate">登录</button><button wx:if="{{registrationAvailable}}" data-page="account" data-mode="register" bindtap="navigate">注册</button></view><view class="account-navigation"><button wx:if="{{actor}}" data-page="account" bindtap="navigate">个人中心</button></view></view>
  <view wx:if="{{mode === 'mock'}}" class="notice">本地联调 · 模拟目录与结果，非真实计算 / OCR</view>
  <view wx:if="{{mode === 'local'}}" class="notice">本地计算 · 数据未冻结 · 识图尚未接入</view>
  <view wx:if="{{mode === 'native-fixture'}}" class="notice">本地接口联调 · fixture身份，非真实微信鉴权</view>
  <view wx:if="{{initializing}}" class="notice">正在验证会话与数据…</view>
  <view wx:if="{{serviceStatus.message}}" class="notice">{{serviceStatus.message}}</view>
  <button wx:if="{{serviceStatus.online === false}}" disabled="{{busy}}" bindtap="reconnect">重新连接</button>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{connectionFailed}}" bindtap="reconnect">重新连接</button>
  <view wx:if="{{ready}}">
   <view class="toolbar">
    <view class="mode-row">
     <button class="toggle-choice {{server === 'cn' ? 'active' : ''}}" data-server="cn" bindtap="switchServer">国服</button>
     <button class="toggle-choice {{server === 'global' ? 'active' : ''}}" data-server="global" bindtap="switchServer">国际服</button>
    </view>
    <view wx:if="{{tiers.length > 1}}" class="mode-row tier-row {{tierSlider ? 'has-slider' : ''}}">
     <view wx:if="{{tierSlider}}" class="toggle-slider" style="{{tierSlider}}" aria-hidden="true"></view>
     <button wx:for="{{tiers}}" wx:key="*this" class="toggle-choice {{tierIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectTier">{{item}}档</button>
    </view>
    <view wx:if="{{zones.length > 1}}" class="mode-row zone-row {{zoneSlider ? 'has-slider' : ''}}">
     <view wx:if="{{zoneSlider}}" class="toggle-slider" style="{{zoneSlider}}" aria-hidden="true"></view>
     <button wx:for="{{zones}}" wx:key="*this" class="toggle-choice {{zoneIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectZone">{{item}}</button>
    </view>
   </view>
   <view class="card ocr-workspace">
    <view class="recognition-entry">
     <button wx:if="{{server === 'cn'}}" disabled="{{busy || (serviceStatus && !serviceStatus.recognitionEnabled)}}" bindtap="chooseImage">{{image ? '更换截图' : '截图文字提取'}}</button>
     <text class="ocr-purpose">{{server === 'cn' ? '从相册选择文字清晰的截图，提取五个名称以辅助填写。' : '国际服支持手动填写'}}</text>
    </view>
    <view wx:if="{{image}}" class="recognition">
     <image src="{{image}}" mode="widthFix" class="preview" />
     <view class="actions"><button wx:if="{{!serviceStatus.canRetry}}" hidden="{{busy}}" bindtap="recognize">重新识别</button><button wx:if="{{serviceStatus.canRetry}}" loading="{{busy}}" disabled="{{busy}}" bindtap="retryRecognition">继续查询</button><button wx:if="{{busy}}" bindtap="stopRecognition">取消识别</button><button hidden="{{busy}}" bindtap="cancelRecognition">移除图片</button></view>
    </view>
    <view wx:if="{{hasPending}}" class="recognition">
     <view class="section-title">核对地图</view>
     <view class="map-row" wx:for="{{slotRows}}" wx:key="index">
      <text class="number">{{item.index + 1}}</text>
      <view class="map-fields">
       <view class="map-field"><button id="review-map-{{item.index}}-big" class="map-picker map-trigger" data-index="{{item.index}}" data-field="big" data-pending="{{true}}" bindtap="openDropdown"><view class="select"><text>{{item.big || '选择大地图'}}</text><text class="chevron" aria-hidden="true"/></view></button></view>
       <view class="map-field"><button id="review-map-{{item.index}}-small" class="map-picker map-trigger" wx:if="{{item.big}}" data-index="{{item.index}}" data-field="small" data-pending="{{true}}" bindtap="openDropdown"><view class="select"><text>{{item.small || '选择小地图'}}</text><text class="chevron" aria-hidden="true"/></view></button><view wx:else class="select is-disabled map-disabled" aria-disabled="true">先选大地图<text class="chevron" aria-hidden="true"/></view></view>
      </view>
     </view>
     <button class="primary" bindtap="applyRecognition">应用选图</button>
    </view>
    <view wx:if="{{ocrBusy}}" class="ocr-status">识别中…</view>
   </view>
   <view class="card map-section">
    <view class="map-row {{item.topOpen ? 'is-top-open' : ''}}" wx:for="{{rows}}" wx:key="index">
     <text class="number">{{item.index + 1}}</text>
     <view class="map-fields">
     <view class="map-field"><view class="field-label">大地图</view><button id="map-{{item.index}}-big" class="map-picker map-trigger" data-index="{{item.index}}" data-field="big" bindtap="openDropdown"><view class="select"><text>{{item.big || '选择大地图'}}</text><text class="chevron" aria-hidden="true"/></view></button></view>
     <view class="map-field"><view class="field-label">小地图</view><button id="map-{{item.index}}-small" class="map-picker map-trigger" wx:if="{{item.big}}" data-index="{{item.index}}" data-field="small" bindtap="openDropdown"><view class="select"><text>{{item.small || '选择小地图'}}</text><text class="chevron" aria-hidden="true"/></view></button><view wx:else class="select is-disabled map-disabled" aria-disabled="true">先选大地图<text class="chevron" aria-hidden="true"/></view></view>
     </view>
     <view wx:if="{{item.top}}" class="track-top-cars">
      <button class="top-toggle" data-index="{{item.index}}" bindtap="toggleTop">{{item.topOpen ? '▾' : '▸'}} {{item.top.label}}</button>
      <view wx:if="{{item.topOpen}}">
       <view class="track-top-note">单图参考，未扣除其他图用车。成绩沿用当前档位与星级口径。</view>
       <view wx:if="{{!item.top.items.length}}" class="track-top-note">当前车库下无可用车</view>
       <view wx:for="{{item.top.items}}" wx:for-item="topCar" wx:key="car" class="track-top-item">
        <view>{{index + 1}}. {{topCar.car}}{{topCar.oc ? ' [OC]' : ''}}<text wx:if="{{topCar.stars !== null}}"> ★{{topCar.stars}}</text><text class="track-top-score">{{topCar.scoreText}}</text></view>
        <template is="video-links" data="{{entry:topCar, rowIndex:item.index, section:'rows'}}"/>
       </view>
      </view>
     </view>
    </view>
   </view>
   <view class="card garage">
    <button class="garage-heading" bindtap="toggleGarage"><view>我的车库 · 已选 {{selectedCount}} 辆</view><text class="muted">{{garageOpen ? '收起 ▴' : '展开 ▾'}}</text></button>
    <view wx:if="{{garageOpen}}">
    <view wx:if="{{actor}}" class="cloud-profile"><view>{{cloudStatus}}</view><button wx:if="{{!cloudLoaded}}" bindtap="syncAccount">重试读取账号车库</button><button wx:if="{{!writeAcceptance && !readbackAcceptance && !conflictAcceptance && !formalWriteCandidate}}" bindtap="importGarage">导入本机游客车库</button><button wx:if="{{allowCloudWrites}}" bindtap="recoverCloud">核对上次保存</button><button wx:if="{{writeAcceptance || conflictAcceptance}}" disabled="{{cloudSaving}}" bindtap="reloadCloud">认证GET重载当前服</button><view wx:if="{{cloudEmpty}}">账号尚未保存此服车库（null）。</view>
     <view wx:if="{{cloudConflict}}"><view>本地 {{cloudConflict.local ? cloudConflict.local.cars.length : 0}} 辆 · 云端 {{cloudConflict.remote ? cloudConflict.remote.cars.length : 0}} 辆</view><view>两份车库均已保留，请明确选择。</view><view wx:if="{{cloudConflict.localText}}">本次提交 revision {{cloudConflict.localRevision}}：{{cloudConflict.localText}}</view><view wx:if="{{cloudConflict.remoteText}}">当前云端 revision {{cloudConflict.remoteRevision}}：{{cloudConflict.remoteText}}</view><button bindtap="restore">加载云端版本</button><button wx:if="{{allowCloudWrites && !writeAcceptance && !conflictAcceptance}}" bindtap="overwriteCloud">保存本地版本</button></view>
    </view>
    <view class="garage-actions"><view class="garage-action-group"><button disabled="{{cloudSaving || (conflictAcceptance && cloudConflict) || (actor && (!allowCloudWrites || !cloudLoaded))}}" bindtap="save">保存车库</button><button bindtap="restore">恢复已保存</button></view>
     <view class="garage-action-group"><button data-action="select-all" bindtap="selectAll">全部点亮</button><button data-action="clear-all" bindtap="clearAll">全部清空</button><button data-action="sort" bindtap="cycleSort">{{sortLabel}}</button></view>
     <text wx:if="{{actor ? cloudDirty : dirty}}" class="save-status">{{actor && !allowCloudWrites ? '车库只读 · 临时修改仅保存在本机' : '手动保存 · 点击保存才会更新车库'}}</text></view>
     <view wx:if="{{zoneHint}}" class="zone-hint">星级代表加速所改装的星级，仅作为参考</view>
     <input class="search" placeholder="搜索车辆（支持昵称/真名）…" placeholder-class="muted" value="{{query}}" bindinput="search" />
     <view class="class-filter"><button wx:for="{{classes}}" wx:key="*this" class="{{carClass === item ? 'active' : ''}}" data-value="{{item}}" bindtap="filterClass">{{item || '全部'}}</button></view>
     <scroll-view scroll-y="{{true}}" class="garage-list">
      <view class="car-grid">
       <view wx:for="{{cars}}" wx:key="id" class="car-row {{item.selected ? 'selected' : ''}}">
        <button class="car-name" data-id="{{item.id}}" bindtap="toggleCar">{{item.label}}</button>
        <button id="star-{{index}}" class="star-picker" data-id="{{item.id}}" data-anchor="{{index}}" bindtap="openStars"><view class="star-select">★{{item.stars[item.starIndex]}}</view></button>
        <button wx:if="{{item.ocAllowed}}" disabled="{{!item.selected}}" class="oc-toggle {{item.oc ? 'oc-on' : ''}}" data-id="{{item.id}}" bindtap="toggleOc">OC</button>
       </view>
      </view>
      <view wx:if="{{!cars.length}}" class="empty-search">没有匹配的车辆</view>
     </scroll-view>
    </view>
   </view>
   <view class="action"><button class="primary recommend-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="compute">生成方案</button></view>
   <view class="card results">
    <view class="result-toolbar">
    <view class="result-heading"><text>方案</text><text class="badge">{{schemes.length}}</text></view>
    <button wx:if="{{activeScheme}}" id="scheme-trigger" class="scheme-trigger" bindtap="openScheme"><view class="select scheme-select"><text>{{schemeOptions[schemeIndex]}}</text><text class="chevron" aria-hidden="true"/></view></button>
    <view wx:if="{{!activeScheme}}" class="scheme-trigger scheme-empty"><view class="select scheme-select"><text>请至少选择一张地图</text><text class="chevron" aria-hidden="true"/></view></view>
    </view>
    <view wx:if="{{!activeScheme && !resultGuidance && !error && !busy}}" class="empty-result">{{emptyResultText}}</view>
    <view wx:if="{{resultGuidance}}" class="result-guidance" aria-role="status">
      <text>{{resultGuidance.message}}</text>
    </view>
   <view wx:if="{{routes.length}}" class="route-panel">
    <view class="route-title">特殊跑法</view>
    <view class="route-list">
     <view wx:for="{{routes}}" wx:key="key" class="route-row {{item.enabled ? 'is-on' : ''}}">
      <button class="route-toggle" data-key="{{item.key}}" bindtap="toggleRoute">{{item.label}} {{item.enabled ? '◉' : '○'}}</button>
      <button wx:if="{{item.showTypes}}" id="route-{{index}}" data-index="{{index}}" class="route-selector" bindtap="openRoute"><view class="route-select">{{item.options[item.optionIndex]}} ⌄</view></button>
     </view>
    </view>
   </view>
    <view class="result-grid">
     <view wx:for="{{resultRows}}" wx:for-item="row" wx:key="index" class="result-row {{row.empty ? 'is-empty' : ''}}">
      <view class="result-main">
      <view class="result-track"><view class="result-map">{{row.map}}</view><view class="result-big">{{row.big || '—'}}</view></view>
      <view class="result-car {{row.empty ? 'empty' : ''}}">
       <text class="result-car-label">{{row.empty && activeScheme ? (row.configured ? '无可用车' : '空位') : row.car}}{{row.oc ? ' [OC]' : ''}}</text><text wx:if="{{row.stars}}" class="result-stars">★{{row.stars}}</text>
       <button wx:if="{{mapBansAvailable && hasComputedResult && row.configured}}" class="map-ban-trigger {{row.banCount ? 'is-active' : ''}}" data-index="{{row.index}}" bindtap="openMapBans" disabled="{{busy}}" aria-label="{{row.map}}禁车设置，已禁{{row.banCount}}辆"><text>⊘ 禁车{{row.banCount ? ' ' + row.banCount : ''}}</text></button>
      </view>
      <view wx:if="{{row.hasTime}}" class="result-time">{{row.timeValue}}<text class="result-unit"> 秒</text></view>
      </view>
      <template is="video-links" data="{{entry:row, rowIndex:row.index, section:'resultRows'}}"/>
     </view>
    </view>
   </view>
  </view>
 </view>
 <view wx:if="{{banEditor}}" class="hub-backdrop" bindtap="closeMapBans">
  <scroll-view scroll-y="{{true}}" class="hub-dialog map-ban-dialog" catchtap="keepMapBansOpen">
   <view class="map-ban-content">
    <view class="map-ban-title">{{banEditor.title}} · 禁车</view>
    <view class="map-ban-hint">勾选本图不用的车辆，取消勾选即可恢复。</view>
    <view class="map-ban-actions"><button bindtap="selectAllMapBans">全选</button><button bindtap="clearMapBanChecks">取消全选</button></view>
    <view class="map-ban-list">
     <checkbox-group class="map-ban-choices" bindchange="changeMapBans">
      <label wx:for="{{banEditor.cars}}" wx:key="id" class="map-ban-choice">
       <checkbox value="{{item.id}}" checked="{{item.checked}}" color="#58a6ff"/>{{item.id}}<text wx:if="{{item.id === banEditor.currentCar}}" class="map-ban-current">当前</text>
      </label>
     </checkbox-group>
     <view wx:if="{{!banEditor.cars.length}}" class="muted">当前车库没有本图候选车辆</view>
    </view>
    <view class="map-ban-actions">
     <button bindtap="closeMapBans">取消</button>
     <button class="primary" bindtap="applyMapBans">应用</button>
    </view>
   </view>
  </scroll-view>
 </view>
 <view wx:if="{{dropdown}}" class="dropdown-backdrop" catchtap="closeDropdown" catchtouchmove="blockDropdownScroll"></view>
 <view wx:if="{{dropdown}}" class="dropdown-menu" style="left:{{dropdown.left}}px;top:{{dropdown.top}}px;width:{{dropdown.width}}px;">
  <scroll-view class="dropdown-list" scroll-y="{{true}}" scroll-into-view="{{dropdown.scrollTo}}" style="height:{{dropdown.maxHeight}}px;">
   <button wx:for="{{dropdown.options}}" wx:key="value" id="dropdown-option-{{item.value}}" class="dropdown-option {{item.selected ? 'is-selected' : ''}} {{item.disabled ? 'is-unavailable' : ''}}" disabled="{{item.disabled}}" data-value="{{item.value}}" bindtap="chooseDropdown"><text>{{item.label}}</text><text wx:if="{{item.selected}}" class="dropdown-check">✓</text></button>
  </scroll-view>
 </view>
</view>
