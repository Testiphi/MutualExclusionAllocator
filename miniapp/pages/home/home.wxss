.page { padding: 30rpx 24rpx 70rpx; padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); }
.brand { font-size: 40rpx; font-weight: 700; margin-bottom: 20rpx; }
.subtitle { font-size: 25rpx; font-weight: 400; color: #a9bad1; }
.notice { border: 1rpx solid #b58a42; background: #342c1c; color: #f0d29b; padding: 18rpx; border-radius: 12rpx; margin-bottom: 20rpx; font-size: 24rpx; }
.toolbar, .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; }
.toolbar button { padding: 0 25rpx; }
.card { background: #141f33; border: 1rpx solid #29374e; border-radius: 20rpx; padding: 24rpx; margin: 24rpx 0; }
.section-title { font-weight: 600; margin-bottom: 22rpx; }
.map-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 16rpx; }
.number { color: #8fa5c7; width: 28rpx; flex-shrink: 0; }
.map-picker { flex: 1; min-width: 0; }
.select { padding: 18rpx 12rpx; border-radius: 10rpx; background: #22314a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.muted { font-size: 24rpx; color: #9aadc8; }
.card > .muted { display: block; margin-top: 14rpx; }
.error { color: #ffd4cc; background: #4b2630; border-radius: 12rpx; padding: 18rpx; margin-top: 20rpx; }
.preview { width: 100%; border-radius: 12rpx; margin: 18rpx 0; }
.recognition { margin-top: 24rpx; }
.search { height: 80rpx; padding: 0 18rpx; background: #0c1628; border-radius: 12rpx; margin: 18rpx 0; }
.garage-list { height: 480rpx; }
.car-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.car-name { flex: 1; min-width: 0; padding: 0 12rpx; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.selected { color: #bfdaff; background: #234c87; }
.oc { display: flex; align-items: center; font-size: 24rpx; }
.oc switch { transform: scale(.75); transform-origin: right center; width: 90rpx; }
.actions { margin-top: 20rpx; }
.actions button { padding: 0 20rpx; }
.result-row { display: flex; justify-content: space-between; gap: 18rpx; padding: 18rpx 0; border-top: 1rpx solid #29374e; }
.result-row text { min-width: 0; overflow-wrap: break-word; }
