<view class="mirror-page"><view class="panel mirror-surface">
 <view class="page-head"><view class="page-title">成绩投稿</view><view class="meta">{{actor.email}} · {{reference}}</view><view class="actions"><button data-view="new" bindtap="switchView" disabled="{{busy}}">提交成绩</button><button data-view="mine" bindtap="switchView" disabled="{{busy}}">我的投稿</button><button wx:if="{{actor.role === 'admin' || actor.role === 'superadmin'}}" bindtap="reviewWorkspace">审核工作台</button></view></view>
 <button wx:if="{{!actor}}" bindtap="login">登录后继续投稿</button><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><button wx:if="{{uncertain}}" bindtap="recover">核对上次操作</button>
 <rp-select label="服别" value="{{server}}" options="{{servers}}" bindchange="changeServer" disabled="{{busy}}"/>
 <view wx:if="{{viewMode === 'mine'}}" class="panel"><view class="heading">我的投稿</view><rp-select label="状态" value="{{status}}" options="{{statusOptions}}" data-key="status" bindchange="filter" disabled="{{busy}}"/><view class="field-label">地图 / 车辆 / 说明</view><input placeholder="搜索投稿" value="{{q}}" bindinput="search" disabled="{{busy}}"/><view class="actions"><button bindtap="refresh" disabled="{{busy}}">查询 / 刷新</button></view><view class="meta">共 {{total || 0}} 条</view><view wx:for="{{items}}" wx:key="id" class="item {{detail.id === item.id ? 'is-current' : ''}}"><button data-id="{{item.id}}" bindtap="open" disabled="{{busy}}">{{item.payload.big}} / {{item.payload.small}} · {{item.payload.car}}</button><view class="muted">{{item.statusLabel}}{{item.unread ? ' · 未读' : ''}} · {{item.timeText}}</view><view class="muted">{{item.summary}}</view></view><view wx:if="{{!items.length}}" class="empty">暂无符合条件的投稿</view><view class="actions"><button data-delta="-1" disabled="{{offset === 0 || busy}}" bindtap="page">上一页</button><button data-delta="1" disabled="{{!hasNext || busy}}" bindtap="page">下一页</button></view><button wx:if="{{created.length > 1}}" bindtap="submitCreated" disabled="{{busy}}">提交刚保存的 {{created.length}} 份草稿</button></view>
 <view wx:if="{{detail}}" class="panel" id="submission-detail"><view class="heading">{{detail.statusLabel}}</view><view class="meta">{{detailVm.contribution.summary}}</view><view class="heading">玩家提交（当前版本）</view><rp-fields items="{{detailVm.fields}}"/><view class="heading">参考库对比</view><view class="body">{{detailVm.comparisonText}}</view><view wx:if="{{detailVm.acceptedFields.length}}"><view class="heading">已采纳内容</view><rp-fields items="{{detailVm.acceptedFields}}"/></view><view wx:if="{{detail.decision_reason}}" class="body">审核意见：{{detail.decision_reason}}</view><button wx:if="{{detail.payload.video_url}}" bindtap="copySource">复制视频来源链接，在浏览器打开</button><view class="heading">证据</view><view wx:for="{{pictures}}" wx:key="id"><image src="{{item.path}}" mode="widthFix" style="width:100%"/><button wx:if="{{canEdit}}" class="danger" data-id="{{item.id}}" bindtap="removeImage" disabled="{{busy}}">移除当前证据（历史保留）</button></view><view wx:if="{{!pictures.length}}" class="muted">暂无图片证据</view><button wx:if="{{canEdit}}" bindtap="upload" disabled="{{busy}}">从相册添加证据（最多3张，每张2MiB）</button><view class="heading">处理记录</view><view wx:for="{{detailVm.events}}" wx:key="index" class="timeline-item"><view>{{item.label}} · {{item.timeText}}</view><view class="body">{{item.text}}</view></view><button bindtap="markRead" disabled="{{busy}}">本条标为已读</button></view>
 <view wx:if="{{viewMode === 'new' || canEdit}}"><view class="heading">{{detail ? '编辑当前投稿' : '录入成绩'}}</view><view wx:for="{{composeRows}}" wx:for-item="row" wx:key="index" class="panel"><view class="heading">第 {{row.index + 1}} 条</view><view class="fields-grid"><rp-select label="区域" value="{{row.entry.zone}}" options="{{zones}}" data-index="{{row.index}}" data-key="zone" bindchange="change" disabled="{{busy || server === 'global'}}"/><rp-select label="建议档位" value="{{row.entry.tier}}" options="{{tiers}}" data-index="{{row.index}}" data-key="tier" bindchange="change" disabled="{{busy || server === 'global'}}"/></view><rp-select label="大地图" value="{{row.entry.big}}" options="{{row.bigs}}" data-index="{{row.index}}" data-key="big" bindchange="change" disabled="{{busy}}"/><rp-select label="小地图" value="{{row.entry.small}}" options="{{row.smalls}}" data-index="{{row.index}}" data-key="small" bindchange="change" disabled="{{busy}}"/><rp-select wx:if="{{!row.entry.unlisted}}" label="车辆（昵称或真名）" value="{{row.entry.car}}" options="{{row.cars}}" data-index="{{row.index}}" data-key="car" bindchange="change" disabled="{{busy}}"/><view wx:else=""><view class="field-label">尚未收录的车辆（昵称或真名）</view><input value="{{row.entry.car}}" data-index="{{row.index}}" data-key="car" bindinput="change" maxlength="150" disabled="{{busy}}"/></view><rp-select label="实际星级（高手必选）" value="{{row.entry.stars}}" options="{{row.starOptions}}" data-index="{{row.index}}" data-key="stars" bindchange="change" disabled="{{busy || maxStarsOnly}}"/><rp-select label="跑法" value="{{row.entry.route}}" options="{{row.routes}}" data-index="{{row.index}}" data-key="route" bindchange="change" disabled="{{busy}}"/><button wx:if="{{server === 'global'}}" data-index="{{row.index}}" data-key="oc" bindtap="toggle" disabled="{{busy}}">{{row.entry.oc ? '✓ OC成绩' : '普通车辆成绩'}}</button><view class="field-label">成绩（秒或分:秒）</view><input placeholder="例如 26.52 或 1:02.345" value="{{row.entry.time}}" data-index="{{row.index}}" data-key="time" bindinput="change" maxlength="24" disabled="{{busy}}"/><view class="field-label">说明、来源或需要补充的资料</view><textarea value="{{row.entry.notes}}" data-index="{{row.index}}" data-key="notes" bindinput="change" maxlength="2000" disabled="{{busy}}"/><view class="field-label">视频 / 来源链接（可选）</view><input value="{{row.entry.video_url}}" data-index="{{row.index}}" data-key="video_url" bindinput="change" maxlength="1000" disabled="{{busy}}"/><button data-index="{{row.index}}" data-key="unlisted" bindtap="toggle" disabled="{{busy}}">{{row.entry.unlisted ? '✓ ' : ''}}车辆、地图或跑法尚未收录（填写说明）</button><view wx:if="{{server === 'global'}}" class="muted">当前仅开放五区满星理论；需提供来源说明、图片或链接中的至少一项。</view><view wx:if="{{!detail}}" class="actions"><button class="danger" data-index="{{row.index}}" bindtap="remove" disabled="{{busy}}">移除此条</button></view></view>
 <view class="actions" wx:if="{{!detail}}"><button bindtap="add" disabled="{{busy}}">再添一条</button><button data-submit="{{false}}" bindtap="create" disabled="{{busy}}">仅保存草稿</button><button class="primary" data-submit="{{true}}" bindtap="create" disabled="{{busy}}">提交审核</button></view><view class="actions" wx:if="{{detail && canEdit}}"><button bindtap="edit" disabled="{{busy}}">保存当前修改</button><button class="primary" bindtap="submit" disabled="{{busy}}">提交审核</button></view></view>
</view></view>
