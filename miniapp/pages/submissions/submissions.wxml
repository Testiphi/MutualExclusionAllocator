<view class="mirror-page"><view class="panel mirror-surface"><view class="brand">Race<text>Pick</text></view><view class="heading">成绩投稿</view><view class="muted">{{reference}}</view><button wx:if="{{!actor}}" bindtap="login">登录后继续投稿</button>
 <view class="error" wx:if="{{error}}">{{error}}</view><view class="notice">{{message}}</view><button wx:if="{{uncertain}}" bindtap="recover">核对上次操作</button>
 <view class="filters"><rp-select disabled="{{busy}}" label="服别" value="{{server}}" options="{{servers}}" bindchange="changeServer"/><rp-select disabled="{{busy}}" wx:if="{{actor.role === 'admin' || actor.role === 'superadmin'}}" label="队列" value="{{scope}}" options="{{scopes}}" data-key="scope" bindchange="filter"/><rp-select disabled="{{busy}}" label="状态" value="{{status}}" options="{{statusOptions}}" data-key="status" bindchange="filter"/></view><input disabled="{{busy}}" placeholder="地图 / 车辆 / 说明" value="{{q}}" bindinput="search"/><view class="actions"><button bindtap="refresh">查询 / 刷新</button><button bindtap="newEntry">新建投稿</button></view>
 <view class="item" wx:for="{{items}}" wx:key="id"><button data-id="{{item.id}}" bindtap="open">{{item.payload.big}} / {{item.payload.small}} · {{item.payload.car}}<view>{{item.statusLabel}}{{item.unread ? ' · 未读' : ''}}</view></button></view><view class="actions"><button data-delta="-1" disabled="{{offset === 0}}" bindtap="page">上一页</button><text>{{total || 0}} 条</text><button data-delta="1" disabled="{{offset + 50 >= total}}" bindtap="page">下一页</button></view>
 <view wx:if="{{detail}}" class="panel"><view class="heading">{{detail.statusLabel}}</view><view class="item" wx:for="{{detailFacts}}" wx:key="label"><view class="muted">{{item.label}}</view><view class="body">{{item.value}}</view></view><button wx:if="{{detail.payload.video_url}}" bindtap="copySource">复制视频来源链接，在浏览器打开</button><view class="body">{{detail.decision_reason}}</view><view class="muted">质量评分 {{detail.contribution_info.quality_total}}</view><button bindtap="markRead">本条标为已读</button><view class="item" wx:for="{{detail.events}}" wx:key="revision">{{item.action}} · {{item.created_at}}</view><view wx:for="{{pictures}}" wx:key="id"><image src="{{item.path}}" mode="widthFix" style="width:100%"/><button wx:if="{{canEdit}}" data-id="{{item.id}}" bindtap="removeImage">停用此证据</button></view><button wx:if="{{canEdit}}" bindtap="upload">从相册添加证据（≤2MiB）</button></view>
 <view class="heading">{{detail ? '编辑当前投稿' : '录入成绩'}}</view>
 <view wx:for="{{composeRows}}" wx:for-item="row" wx:key="index" class="panel">
  <view>第 {{row.index + 1}} 条</view><rp-select disabled="{{busy}}" label="大地图" value="{{row.entry.big}}" options="{{row.bigs}}" data-index="{{row.index}}" data-key="big" bindchange="change"/><rp-select disabled="{{busy}}" label="小地图" value="{{row.entry.small}}" options="{{row.smalls}}" data-index="{{row.index}}" data-key="small" bindchange="change"/>
  <rp-select label="区域" value="{{row.entry.zone}}" options="{{zones}}" data-index="{{row.index}}" data-key="zone" bindchange="change" disabled="{{server === 'global'}}"/><rp-select label="档位" value="{{row.entry.tier}}" options="{{tiers}}" data-index="{{row.index}}" data-key="tier" bindchange="change" disabled="{{server === 'global'}}"/>
  <rp-select disabled="{{busy}}" label="车辆" value="{{row.entry.car}}" options="{{row.cars}}" data-index="{{row.index}}" data-key="car" bindchange="change"/><rp-select disabled="{{busy}}" label="星级" value="{{row.entry.stars}}" options="{{stars}}" data-index="{{row.index}}" data-key="stars" bindchange="change"/><rp-select disabled="{{busy}}" label="跑法" value="{{row.entry.route}}" options="{{row.routes}}" data-index="{{row.index}}" data-key="route" bindchange="change"/>
  <button wx:if="{{server === 'global'}}" data-index="{{row.index}}" data-key="oc" bindtap="toggle">{{row.entry.oc ? '✓ OC' : '普通车辆'}}</button><view class="field-label">成绩（秒）</view><input disabled="{{busy}}" value="{{row.entry.time}}" data-index="{{row.index}}" data-key="time" bindinput="change" maxlength="24"/><view class="field-label">说明 / 理论来源</view><textarea disabled="{{busy}}" value="{{row.entry.notes}}" data-index="{{row.index}}" data-key="notes" bindinput="change" maxlength="2000"/><view class="field-label">视频来源链接（可选）</view><input disabled="{{busy}}" value="{{row.entry.video_url}}" data-index="{{row.index}}" data-key="video_url" bindinput="change" maxlength="1000"/><button data-index="{{row.index}}" data-key="unlisted" bindtap="toggle">{{row.entry.unlisted ? '✓ 不公开列出' : '公开列出'}}</button><button wx:if="{{!detail}}" data-index="{{row.index}}" bindtap="remove">移除此条</button>
 </view>
 <view class="actions" wx:if="{{!detail}}"><button bindtap="add">再添一条</button><button data-submit="{{false}}" bindtap="create" disabled="{{busy}}">仅保存草稿</button><button class="primary" data-submit="{{true}}" bindtap="create" disabled="{{busy}}">提交审核</button></view><view class="actions" wx:if="{{detail && canEdit}}"><button bindtap="edit" disabled="{{busy}}">保存当前修改</button><button class="primary" bindtap="submit" disabled="{{busy}}">提交审核</button></view>
</view></view>
