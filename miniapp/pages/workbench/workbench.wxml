<view class="mirror-page"><view class="panel mirror-surface">
 <view class="page-head"><view class="page-title">{{viewTitle || '管理工作台'}}</view><view class="meta">{{actor.email}} · {{actor.role === 'superadmin' ? '超级管理员' : actor.role === 'admin' ? '管理员' : '请先登录有权限的账号'}} · 本地环境</view><rp-select label="管理导航" disabled="{{busy}}" value="{{tab}}" options="{{tabs}}" bindchange="changeTab"/></view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><button wx:if="{{uncertain}}" bindtap="recover">查询上次操作结果</button>
 <view wx:if="{{actor.role === 'admin' || actor.role === 'superadmin'}}">
  <view class="actions"><button bindtap="toggleReauth">{{showReauth ? '收起账号认证' : '更新账号认证'}}</button><button bindtap="load" loading="{{busy}}" disabled="{{busy}}">查询 / 刷新</button></view>
  <view wx:if="{{showReauth || tab === 'versions'}}" class="panel"><view class="heading">{{tab === 'versions' ? '执行前身份确认' : '账号认证'}}</view><view class="field-label">当前账号密码</view><input disabled="{{busy}}" password="{{true}}" value="{{password}}" data-key="password" bindinput="input" maxlength="128"/><view class="actions"><button bindtap="reauth" disabled="{{busy}}">更新账号认证</button><button wx:if="{{tab === 'versions'}}" bindtap="scoreReauth" disabled="{{busy}}">验证成绩操作（5分钟有效）</button></view></view>
  <view wx:if="{{filters.length}}" class="panel"><view class="filters"><view wx:for="{{filters}}" wx:key="key"><rp-select wx:if="{{item.options}}" disabled="{{busy}}" label="{{item.label}}" value="{{query[item.key]}}" options="{{item.options}}" data-key="{{item.key}}" bindchange="filter"/><view wx:else=""><view class="field-label">{{item.label}}</view><input disabled="{{busy}}" value="{{query[item.key]}}" data-key="query.{{item.key}}" bindinput="input"/></view></view></view><button disabled="{{busy}}" bindtap="load">查询</button></view>

  <view wx:if="{{tab === 'accounts'}}" class="panel"><view>共 {{total || 0}} 个账号</view><view class="muted">左右滑动查看最近活动、投稿和操作。</view><scroll-view scroll-x="{{true}}" class="table-scroll"><view class="accounts-table"><view class="table-row table-head"><view class="table-cell email-cell">账号 / 昵称</view><view class="table-cell">角色 / 状态</view><view class="table-cell activity-cell">最近活动</view><view class="table-cell count-cell">投稿</view><view class="table-cell actions-cell">操作</view></view><view wx:for="{{items}}" wx:key="id" class="table-row"><view class="table-cell email-cell"><button class="plain-link" data-id="{{item.id}}" bindtap="open">{{item.email}}</button><view class="muted">{{item.nickname || '未设置昵称'}}{{item.leaderboard_anonymous ? ' · 榜单匿名' : ''}}</view></view><view class="table-cell">{{item.roleLabel}}<view>{{item.accountStatus}} · {{item.verifiedText}}</view></view><view class="table-cell activity-cell"><view>最近交互：{{item.lastInteraction}}</view><view class="muted">最近访问：{{item.lastVisit}}</view><view class="muted">最近登录：{{item.lastLogin}}</view></view><view class="table-cell count-cell">{{item.submissions}}</view><view class="table-cell actions-cell"><button data-id="{{item.id}}" bindtap="open">访问与活跃 / 处理</button><view wx:if="{{item.role === 'superadmin'}}" class="muted">主号受保护</view></view></view></view></scroll-view></view>

  <view wx:if="{{tab === 'review' || tab === 'feedback' || tab === 'activity'}}" class="panel"><view class="heading">{{tab === 'review' ? '投稿队列' : tab === 'feedback' ? '用户反馈' : '逐账号访问与活跃'}}</view><view wx:if="{{tab === 'feedback'}}" class="muted">待处理 {{pendingFeedback || 0}} 条</view><view class="meta">共 {{total || 0}} 条</view><view wx:if="{{!items.length}}" class="empty">暂无符合条件的记录</view><view wx:for="{{items}}" wx:key="id" class="item {{detail.id === item.id ? 'is-current' : ''}}"><button data-id="{{item.id}}" bindtap="open" disabled="{{busy}}">{{item.label}}</button><view class="muted">{{item.statusLabel}}{{item.unread ? ' · 未读' : ''}}</view><view wx:if="{{item.summary}}" class="muted">{{item.summary}}</view><view class="muted">{{item.timeText}}</view></view></view>
  <view wx:if="{{tab === 'review' || tab === 'feedback' || tab === 'accounts' || tab === 'activity'}}" class="actions"><button data-delta="-1" disabled="{{offset === 0 || busy}}" bindtap="page">上一页</button><text>{{total || 0}} 条 · 第 {{pageNumber || 1}} 页</text><button data-delta="1" disabled="{{!hasNext || busy}}" bindtap="page">下一页</button></view>

  <view wx:if="{{tab === 'review' && detail}}" class="panel" id="review-detail"><view class="heading">{{detailVm.statusLabel}}</view><view class="meta">{{detailVm.contribution.summary}}</view><view wx:if="{{selfReview}}" class="notice">本人合资格投稿不能由本人审核或评分。</view><view class="heading">玩家提交（当前版本）</view><rp-fields items="{{detailVm.fields}}"/><view class="heading">参考库对比</view><view class="body">{{detailVm.comparisonText}}</view><view wx:if="{{detailVm.acceptedFields.length}}"><view class="heading">已采纳内容</view><rp-fields items="{{detailVm.acceptedFields}}"/></view><view class="heading">证据</view><view wx:if="{{!pictures.length}}" class="muted">暂无图片证据</view><image wx:for="{{pictures}}" wx:key="id" src="{{item.path}}" mode="widthFix" style="width:100%"/>
   <view wx:if="{{canReview}}"><view class="heading">拟采纳内容</view><view class="fields-grid"><rp-select disabled="{{busy}}" label="区域" value="{{reviewEntry.zone}}" options="{{reviewZones}}" data-key="reviewEntry.zone" bindchange="input"/><rp-select disabled="{{busy}}" label="档位" value="{{reviewEntry.tier}}" options="{{reviewTiers}}" data-key="reviewEntry.tier" bindchange="input"/></view><rp-select disabled="{{busy}}" label="大地图" value="{{reviewEntry.big}}" options="{{reviewBigs}}" data-key="reviewEntry.big" bindchange="input"/><rp-select disabled="{{busy}}" label="小地图" value="{{reviewEntry.small}}" options="{{reviewSmalls}}" data-key="reviewEntry.small" bindchange="input"/><rp-select disabled="{{busy}}" label="车辆" value="{{reviewEntry.car}}" options="{{reviewCars}}" data-key="reviewEntry.car" bindchange="input"/><rp-select disabled="{{busy || reviewCatalog.capabilities.max_stars_only}}" label="星级" value="{{reviewEntry.stars}}" options="{{reviewStars}}" data-key="reviewEntry.stars" bindchange="input"/><rp-select disabled="{{busy}}" label="跑法" value="{{reviewEntry.route}}" options="{{reviewRoutes}}" data-key="reviewEntry.route" bindchange="input"/><button wx:if="{{reviewEntry.server === 'global'}}" data-key="reviewEntry.oc" bindtap="toggleReview">{{reviewEntry.oc ? '✓ OC超频' : '普通车辆'}}</button><view class="field-label">成绩（秒）</view><input disabled="{{busy}}" value="{{reviewEntry.time}}" data-key="reviewEntry.time" bindinput="input"/><view class="field-label">说明 / 理论来源</view><textarea disabled="{{busy}}" value="{{reviewEntry.notes}}" data-key="reviewEntry.notes" bindinput="input" maxlength="2000"/><view class="field-label">视频来源链接</view><input disabled="{{busy}}" value="{{reviewEntry.video_url}}" data-key="reviewEntry.video_url" bindinput="input" maxlength="1000"/><button data-key="reviewEntry.unlisted" bindtap="toggleReview">{{reviewEntry.unlisted ? '✓ 不目标已收录' : '目标已收录'}}</button><button bindtap="previewReview" disabled="{{busy}}">预览变更</button>
    <view wx:if="{{preview}}" class="panel"><view class="heading">当前预览</view><view class="body">{{previewSummary}}</view><view class="body">{{comparisonText}}</view></view>
   </view>
   <view wx:if="{{canReview || canRate}}"><view wx:if="{{detail.contribution_info.eligible}}"><view class="heading">贡献质量评分（0–10，与是否采用独立）</view><rp-select label="信息完整性（0–3）" value="{{quality.completeness}}" options="{{quality3}}" data-key="quality.completeness" bindchange="input" disabled="{{busy}}"/><rp-select label="证据可核验性（0–4）" value="{{quality.evidence}}" options="{{quality4}}" data-key="quality.evidence" bindchange="input" disabled="{{busy}}"/><rp-select label="数据参考价值（0–3）" value="{{quality.value}}" options="{{quality3}}" data-key="quality.value" bindchange="input" disabled="{{busy}}"/><view wx:if="{{canRate}}" class="field-label">评分依据</view><textarea wx:if="{{canRate}}" value="{{quality.reason}}" data-key="quality.reason" bindinput="input" disabled="{{busy}}" maxlength="1000"/></view><rp-select wx:else="" label="历史评分（0–5，不计贡献）" value="{{legacyScore}}" options="{{legacyScores}}" data-key="legacyScore" bindchange="input" disabled="{{busy}}"/></view>
   <view wx:if="{{canReview || canReopen}}"><view class="field-label">审核意见（投稿人可见）</view><textarea value="{{reason}}" data-key="reason" bindinput="input" maxlength="{{detail.contribution_info.eligible ? 1000 : 2000}}" disabled="{{busy}}"/></view><button wx:if="{{canReview && preview.comparison.kind === 'slower'}}" bindtap="toggleSlower">{{slowerConfirmed ? '✓ 已确认接受较慢成绩' : '再次确认接受较慢成绩'}}</button>
   <view class="actions"><button wx:if="{{canReview}}" class="primary" id="review-accept" data-action="accept" disabled="{{!preview || preview.comparison.kind === 'rule_needed' || busy}}" bindtap="review">采纳</button><button wx:if="{{canReview}}" data-action="needs_info" bindtap="review" disabled="{{busy}}">要求补充</button><button wx:if="{{canReview}}" data-action="ignore" bindtap="review" disabled="{{busy}}">忽略本条</button><button wx:if="{{canReopen}}" data-action="reopen" bindtap="review" disabled="{{busy}}">重新打开</button><button wx:if="{{canRate}}" bindtap="rate" disabled="{{busy}}">保存 / 调整质量评分</button><button bindtap="markRead" disabled="{{busy}}">本条标为已读</button></view>
   <view class="heading">处理记录</view><view wx:for="{{detailVm.events}}" wx:key="index" class="timeline-item"><view>{{item.label}} · {{item.timeText}}</view><view class="body">{{item.text}}</view></view><button class="plain-link" bindtap="toggleTechnical">{{technicalOpen ? '收起来源与修订信息' : '查看来源与修订信息'}}</button><rp-fields wx:if="{{technicalOpen}}" items="{{detailFacts}}"/>
  </view>

  <view wx:if="{{tab === 'feedback' && detail}}" class="panel" id="feedback-detail"><view class="heading">{{detail.title}}</view><view class="meta">{{detail.owner_email}} {{detail.owner_nickname}} · {{detailVm.timeText}}</view><view class="pill">{{detailVm.statusLabel}}</view><view class="heading">问题描述</view><view class="body">{{detail.description}}</view><view class="heading">复现步骤</view><view class="body">{{detail.steps || '未填写'}}</view><view class="heading">预期 / 实际</view><view class="body">{{detail.expected || '未填写'}} / {{detail.actual || '未填写'}}</view><view wx:for="{{detailVm.events}}" wx:key="index" class="timeline-item"><view class="meta">{{item.roleLabel}} · {{item.timeText}}</view><view class="body">{{item.text}}</view></view><view class="heading">回复并处理</view><rp-select label="处理状态" value="{{handleStatus}}" options="{{handleStatuses}}" data-key="handleStatus" bindchange="input" disabled="{{busy}}"/><textarea placeholder="回复内容" value="{{reason}}" data-key="reason" bindinput="input" maxlength="4000" disabled="{{busy}}"/><view class="actions"><button class="primary" bindtap="handle" disabled="{{busy}}">回复并更新状态</button><button bindtap="markRead">本条标为已读</button></view></view>

  <view wx:if="{{tab === 'accounts' && detail}}" class="panel" id="account-detail"><view class="heading">{{detail.email}}</view><view class="meta">{{detailVm.roleLabel}} · {{detailVm.accountStatus}} · {{detailVm.verifiedText}}</view><view>最近登录：{{detailVm.lastLogin}}</view><view>最近访问：{{detailVm.lastVisit}}</view><view>最近交互：{{detailVm.lastInteraction}}</view><view class="actions"><button data-id="{{detail.id}}" bindtap="openActivity">查看访问与活跃</button></view><view wx:if="{{detail.role !== 'superadmin'}}"><rp-select label="账号操作" value="{{accountAction}}" options="{{accountActions}}" data-key="accountAction" bindchange="input" disabled="{{busy}}"/><textarea placeholder="操作原因（1–200字）" value="{{reason}}" data-key="reason" bindinput="input" maxlength="200" disabled="{{busy}}"/><button class="danger" bindtap="control" disabled="{{busy}}">确认账号操作</button></view><view wx:else="" class="muted">主号超级管理员受保护。</view><view class="heading">访问 / 处理审计</view><view wx:for="{{detailVm.events}}" wx:key="index" class="timeline-item">{{item.label}} · {{item.timeText}}<view class="body">{{item.text}}</view></view></view>

  <view wx:if="{{tab === 'invitations'}}"><view class="panel"><view class="heading">邀请管理员</view><view class="muted">绑定受邀邮箱，仅可使用一次。完整邀请码仅生成时显示，不自动发送邀请邮件。</view><view class="field-label">受邀邮箱</view><input value="{{form.email}}" data-key="form.email" bindinput="input" maxlength="254" disabled="{{busy}}"/><rp-select label="有效期" value="{{form.expires_hours}}" options="{{inviteHours}}" data-key="form.expires_hours" bindchange="input" disabled="{{busy}}"/><button class="primary" bindtap="invite" disabled="{{busy}}">生成邀请码</button><view wx:if="{{invitationCode}}" class="notice"><view>邀请码（仅本次显示）</view><text selectable="{{true}}">{{invitationCode}}</text><view class="actions"><button bindtap="copyInvitation">复制邀请码</button><button bindtap="clearInvitation">已保存，关闭</button></view></view></view><view class="panel"><view class="heading">最近的邀请</view><view wx:for="{{items}}" wx:key="id" class="item"><view>{{item.email}}</view><view class="meta">{{item.statusLabel}} · 到期 {{item.expiresText}}</view><button wx:if="{{item.status === 'open' || item.status === 'reserved'}}" class="danger" data-id="{{item.id}}" bindtap="revokeInvitation" disabled="{{busy}}">撤销邀请</button></view></view></view>
  <view wx:if="{{tab === 'members'}}" class="panel"><view class="heading">管理员</view><view class="muted">主号超级管理员受到保护。收回权限后，账号、车库与投稿保留。</view><textarea placeholder="收回权限原因（1–200字）" value="{{reason}}" data-key="reason" bindinput="input" maxlength="200" disabled="{{busy}}"/><view wx:for="{{items}}" wx:key="id" class="item"><view>{{item.email}} · {{item.roleLabel}}</view><button wx:if="{{item.role !== 'superadmin'}}" class="danger" data-id="{{item.id}}" bindtap="revokeMember" disabled="{{busy}}">收回管理员权限</button><view wx:else="" class="muted">主号受保护</view></view></view>

  <view wx:if="{{tab === 'announcements'}}" class="panel"><view class="heading">公告管理</view><view class="muted">编辑原公告不会重置“不再提醒”；重大新内容请新建公告。</view><view wx:for="{{items}}" wx:key="id" class="item"><button data-id="{{item.id}}" bindtap="open">{{item.title}} · {{item.statusLabel}}</button></view><button bindtap="newForm">新建公告</button><view class="field-label">标题</view><input value="{{form.title}}" data-key="form.title" bindinput="input" maxlength="120" disabled="{{busy}}"/><view class="field-label">功能版本标签</view><input value="{{form.release_label}}" data-key="form.release_label" bindinput="input" maxlength="80" disabled="{{busy}}"/><view class="field-label">正文（纯文本）</view><textarea value="{{form.body}}" data-key="form.body" bindinput="input" maxlength="6000" disabled="{{busy}}"/><view class="actions"><button bindtap="announcementPreview">预览</button><button class="primary" bindtap="saveAnnouncement" disabled="{{busy}}">保存</button><button wx:if="{{detail}}" class="primary" data-action="publish" bindtap="announcementState" disabled="{{busy}}">发布公告</button><button wx:if="{{detail}}" class="danger" data-action="withdraw" bindtap="announcementState" disabled="{{busy}}">撤下公告</button></view><view class="meta">{{detailVm.statusLabel}} · {{detailVm.timeText}}</view><view wx:if="{{announcementPreview}}" class="panel body"><view>{{form.title}}</view><view>{{announcementPreview}}</view></view></view>

  <view wx:if="{{tab === 'usage' && usageVm}}">
   <view class="panel"><view class="heading">实际交互人数</view><view class="muted">滚动窗口截至 {{usageVm.rolling_windows_as_of}} · 北京时间</view><view class="metric-grid"><view wx:for="{{usageVm.windows}}" wx:key="kind" class="metric"><view>{{item.label}}</view><view class="metric-values"><text>日活 <text class="metric-value">{{item.dau}}</text></text><text>周活 <text class="metric-value">{{item.wau}}</text></text><text>月活 <text class="metric-value">{{item.mau}}</text></text></view></view></view><view class="muted">账号跨设备去重。游客按随机标识近似统计，两个分组不直接相加当作真实总人数。</view></view>
   <view class="panel"><view class="heading">活跃时段热力图</view><view class="muted">北京时间累计观察到操作的活跃分钟，不是精确使用时长。</view><view wx:for="{{usageVm.heatmaps}}" wx:for-item="heat" wx:key="kind"><view class="heading">{{heat.label}}</view><scroll-view scroll-x="{{true}}" class="table-scroll"><view class="heat-table"><view class="heat-row"><view class="heat-day muted">星期 / 时</view><view wx:for="{{usageVm.hours}}" wx:key="*this" class="heat-cell heat-head">{{item}}</view></view><view wx:for="{{heat.rows}}" wx:for-item="row" wx:key="day" class="heat-row"><view class="heat-day muted">{{row.day}}</view><view wx:for="{{row.cells}}" wx:key="hour" class="heat-cell" style="background:{{item.color}}" data-day="{{item.day}}" data-hour="{{item.hour}}" data-value="{{item.value}}" bindtap="showHeat">{{item.value || ''}}</view></view></view></scroll-view></view><view class="muted">{{heatHint}}</view></view>
   <view class="panel"><view class="heading">国服 / 国际服比例</view><scroll-view scroll-x="{{true}}" class="table-scroll"><view class="stat-table"><view class="table-row table-head"><view class="table-cell">服别</view><view class="table-cell">打开次数</view><view class="table-cell">占比</view><view class="table-cell">返回次数</view><view class="table-cell">活跃分钟</view></view><view wx:for="{{usageVm.proportions}}" wx:key="label" class="table-row"><view class="table-cell">{{item.label}}</view><view class="table-cell">{{item.opens}}</view><view class="table-cell">{{item.share}}</view><view class="table-cell">{{item.resumes}}</view><view class="table-cell">{{item.active_minutes}}</view></view></view></scroll-view></view>
   <view class="panel"><view class="heading">关键功能使用</view><scroll-view scroll-x="{{true}}" class="table-scroll"><view class="feature-table"><view class="table-row table-head"><view class="table-cell">功能</view><view class="table-cell">结果</view><view class="table-cell">账号次数 / 人数</view><view class="table-cell">游客次数 / 人数</view></view><view wx:for="{{usageVm.features}}" wx:key="index" class="table-row"><view class="table-cell">{{item.label}}</view><view class="table-cell">{{item.resultLabel}}</view><view class="table-cell">{{item.account.uses}} / {{item.account.people}}</view><view class="table-cell">{{item.guest.uses}} / {{item.guest.people}}</view></view></view></scroll-view><view wx:if="{{!usageVm.features.length}}" class="empty">暂无统计记录</view></view>
  </view>

  <view wx:if="{{tab === 'activity' && detail}}" class="panel" id="activity-detail"><view class="heading">账号访问与活跃</view><view class="meta">{{detail.email}}</view><view>首次记录：{{detailVm.firstSeen}}</view><view>最近访问：{{detailVm.lastVisit}}</view><view>最近交互：{{detailVm.lastInteraction}}</view><view class="muted">每页10天，仅列有记录的日期。所有时间均为北京时间。</view><rp-select label="时间范围" value="{{activityPeriod}}" options="{{activityPeriods}}" bindchange="activityRange" disabled="{{busy}}"/><view class="filters"><view><view class="field-label">开始日期</view><input value="{{activityStart}}" data-key="activityStart" bindinput="input" disabled="{{busy}}"/></view><view><view class="field-label">结束日期</view><input value="{{activityEnd}}" data-key="activityEnd" bindinput="input" disabled="{{busy}}"/></view></view><rp-select label="服别" value="{{activityServer}}" options="{{activityServers}}" data-key="activityServer" bindchange="input" disabled="{{busy}}"/><button data-delta="0" bindtap="activityPage">查询</button><view class="metric-values"><text>观察天数 {{detail.summary.observed_days}}</text><text>活跃分钟 {{detail.summary.active_minutes}}</text><text>活跃天数 {{detail.summary.active_days}}</text></view><view wx:for="{{detail.items}}" wx:key="day" class="item"><view>{{item.day}} · 访问 {{item.opens}} · 返回 {{item.resumes}} · 活跃 {{item.active_minutes}} 分钟</view><view wx:for="{{item.features}}" wx:for-item="feature" wx:key="feature" class="muted">{{feature.feature}} · {{feature.result}} · {{feature.uses}} 次</view></view><view wx:if="{{!detail.items.length}}" class="empty">当前范围暂无活动记录</view><view class="actions"><button data-delta="-1" disabled="{{detail.offset === 0 || busy}}" bindtap="activityPage">上一页</button><text>{{detail.total}} 天</text><button data-delta="1" disabled="{{detail.offset + 10 >= detail.total || busy}}" bindtap="activityPage">下一页</button></view></view>

  <view wx:if="{{tab === 'versions'}}"><view class="panel"><view class="heading">已采纳投稿</view><view class="muted">{{production ? '正式环境' : '独立测试环境'}} · {{writeEnabled ? '当前环境允许写回' : '当前环境写回关闭'}}</view><view class="muted">默认不选择。改变选择后须生成新批次。</view><view wx:for="{{items}}" wx:key="id" class="item"><view>{{item.summary}}</view><button data-id="{{item.id}}" bindtap="toggleItem" disabled="{{busy || !writeEnabled}}">{{item.selected ? '✓ 已选' : '选入批次'}}</button></view><button bindtap="prepare" disabled="{{!selected.length || busy || !writeEnabled}}">为所选投稿生成确认预览</button></view><view class="panel"><view class="heading">批次历史与确认</view><button wx:for="{{batches}}" wx:key="id" data-id="{{item.id}}" bindtap="openBatch">{{item.id}} · {{item.state}}</button><view wx:if="{{batch}}"><view class="heading">{{batch.state}}</view><view class="body muted">{{batch.base}} → {{batch.target}}</view><view>新增 {{batch.result.summary.new}} · 更新 {{batch.result.summary.updated}} · 更慢 {{batch.result.summary.slower}} · 普通镜像 {{batch.result.summary.ordinary_mirrors}}</view><view wx:if="{{batch.stale_reasons.length}}" class="error">确认已失效：{{batch.stale_reasons}}</view><view class="heading">本批次完整变更</view><view wx:for="{{batchChanges}}" wx:key="index" class="item"><view>{{item.label}} · {{item.target}}</view><view>{{item.old}} → {{item.next}}</view></view><view wx:if="{{canExecute}}"><view wx:for="{{approvals}}" wx:key="submission_id" class="panel"><view>{{item.label}}</view><button data-index="{{index}}" data-key="confirmed" bindtap="approval">{{item.confirmed ? '✓ 已确认此项全部变更' : '确认此项全部变更'}}</button><button wx:if="{{item.slower}}" data-index="{{index}}" data-key="slower_confirmed" bindtap="approval">{{item.slower_confirmed ? '✓ 已确认接受较慢成绩' : '再次确认接受较慢成绩'}}</button><textarea wx:if="{{item.slower}}" placeholder="接受较慢成绩的原因" value="{{item.slower_reason}}" data-index="{{index}}" data-key="slower_reason" bindinput="approval" disabled="{{busy}}" maxlength="2000"/></view><button bindtap="effects">{{effectsConfirmed ? '✓ 已核对完整变更及普通镜像影响' : '确认已核对完整变更及普通镜像影响'}}</button><button class="primary" bindtap="execute" disabled="{{busy}}">确认发布到测试数据</button></view><view wx:if="{{canRollback || canRecover}}"><textarea placeholder="回滚或恢复原因" value="{{reason}}" data-key="reason" bindinput="input" disabled="{{busy}}" maxlength="2000"/><button wx:if="{{canRollback}}" class="danger" data-action="rollback" bindtap="batchAction" disabled="{{busy}}">整批回滚测试成绩</button><button wx:if="{{canRecover}}" class="danger" data-action="recover" bindtap="batchAction" disabled="{{busy}}">恢复未完成批次</button></view><button class="plain-link" bindtap="toggleTechnical">{{technicalOpen ? '收起来源、确认、备份及回执' : '查看来源、确认、备份及回执'}}</button><rp-fields wx:if="{{technicalOpen}}" items="{{batchFacts}}"/></view></view></view>
 </view>
</view></view>
