<view class="mirror-page"><view class="panel mirror-surface"><view class="brand">Race<text>Pick</text></view><view class="heading">管理工作台</view><view class="notice">业务写入仅供当前独立隔离环境验证。</view><rp-select disabled="{{busy}}" label="工作区" value="{{tab}}" options="{{tabs}}" bindchange="changeTab"/>
 <view class="error" wx:if="{{error}}">{{error}}</view><view class="notice">{{message}}</view><button wx:if="{{uncertain}}" bindtap="recover">查询上次操作结果</button><button wx:if="{{tab === 'announcements'}}" bindtap="newForm">新建公告草稿</button>
 <view class="panel"><view class="field-label">再次验证密码</view><input disabled="{{busy}}" password="{{true}}" value="{{password}}" data-key="password" bindinput="input" maxlength="128"/><view class="actions"><button bindtap="reauth">更新账号认证</button><button wx:if="{{tab === 'versions'}}" bindtap="scoreReauth">验证成绩操作（五分钟）</button></view></view>
 <view class="filters"><view wx:for="{{filters}}" wx:key="key"><rp-select disabled="{{busy}}" wx:if="{{item.options}}" label="{{item.label}}" value="{{query[item.key]}}" options="{{item.options}}" data-key="{{item.key}}" bindchange="filter"/><view wx:else=""><view class="field-label">{{item.label}}</view><input disabled="{{busy}}" value="{{query[item.key]}}" data-key="query.{{item.key}}" bindinput="input"/></view></view></view><button loading="{{busy}}" bindtap="load">查询 / 刷新</button>
 <view wx:if="{{tab === 'versions'}}" class="notice">{{production ? '正式环境' : '隔离环境'}} · {{writeEnabled ? '此环境写回开关开启' : '此环境写回开关关闭'}}</view>
 <view wx:for="{{items}}" wx:key="index" class="item"><button data-id="{{item.id}}" bindtap="open">{{item.label}} · {{item.statusLabel}}</button><view wx:if="{{tab === 'versions'}}"><view>{{item.accepted_payload.big}} / {{item.accepted_payload.small}} · {{item.accepted_payload.time}} 秒</view><button data-id="{{item.id}}" bindtap="toggleItem">{{item.selected ? '✓ 已选' : '选入批次'}}</button></view><button wx:if="{{tab === 'invitations'}}" data-id="{{item.id}}" bindtap="revokeInvitation">撤销邀请</button><button wx:if="{{tab === 'members'}}" data-id="{{item.id}}" bindtap="revokeMember">收回管理员权限</button></view>
 <view wx:if="{{tab === 'review' || tab === 'feedback' || tab === 'accounts' || tab === 'activity'}}" class="actions"><button data-delta="-1" disabled="{{offset === 0}}" bindtap="page">上一页</button><text>{{total || 0}} 条</text><button data-delta="1" bindtap="page">下一页</button></view>
 <view wx:if="{{detail}}" class="panel"><view class="heading">详情与处理记录</view><button wx:if="{{tab === 'review' || tab === 'feedback'}}" bindtap="markRead">本条标为已读</button><view class="item" wx:for="{{detailFacts}}" wx:key="label"><view class="muted">{{item.label}}</view><view class="body">{{item.value}}</view></view></view>
 <view wx:if="{{tab === 'review' && detail}}" class="panel"><view wx:for="{{pictures}}" wx:key="id"><image src="{{item.path}}" mode="widthFix" style="width:100%"/></view><view class="heading">拟采纳内容</view><rp-select disabled="{{busy}}" label="区域" value="{{reviewEntry.zone}}" options="{{reviewZones}}" data-key="reviewEntry.zone" bindchange="input"/><rp-select disabled="{{busy}}" label="档位" value="{{reviewEntry.tier}}" options="{{reviewTiers}}" data-key="reviewEntry.tier" bindchange="input"/><button wx:if="{{reviewEntry.server === 'global'}}" data-key="reviewEntry.oc" bindtap="toggleReview">{{reviewEntry.oc ? '✓ OC' : '普通车辆'}}</button><rp-select disabled="{{busy}}" label="大地图" value="{{reviewEntry.big}}" options="{{reviewBigs}}" data-key="reviewEntry.big" bindchange="input"/><view class="field-label">小地图</view><input disabled="{{busy}}" value="{{reviewEntry.small}}" data-key="reviewEntry.small" bindinput="input"/><rp-select disabled="{{busy}}" label="车辆" value="{{reviewEntry.car}}" options="{{reviewCars}}" data-key="reviewEntry.car" bindchange="input"/><view class="field-label">星级</view><input disabled="{{busy}}" type="number" value="{{reviewEntry.stars}}" data-key="reviewEntry.stars" data-number="{{true}}" bindinput="input"/><view class="field-label">成绩（秒）</view><input disabled="{{busy}}" value="{{reviewEntry.time}}" data-key="reviewEntry.time" bindinput="input"/><rp-select disabled="{{busy}}" label="跑法" value="{{reviewEntry.route}}" options="{{reviewRoutes}}" data-key="reviewEntry.route" bindchange="input"/><view class="field-label">说明 / 理论来源</view><textarea disabled="{{busy}}" value="{{reviewEntry.notes}}" data-key="reviewEntry.notes" bindinput="input"/><input disabled="{{busy}}" placeholder="视频来源链接" value="{{reviewEntry.video_url}}" data-key="reviewEntry.video_url" bindinput="input" maxlength="1000"/><button data-key="reviewEntry.unlisted" bindtap="toggleReview">{{reviewEntry.unlisted ? '✓ 不公开列出' : '公开列出'}}</button><button bindtap="previewReview" disabled="{{busy}}">预览变更</button>
 <view wx:for="{{previewFacts}}" wx:key="label" class="item"><view class="muted">{{item.label}}</view><view class="body">{{item.value}}</view></view>
 <view class="heading">质量评分</view><rp-select disabled="{{busy}}" label="完整性（0–3）" value="{{quality.completeness}}" options="{{quality3}}" data-key="quality.completeness" bindchange="input"/><rp-select disabled="{{busy}}" label="证据（0–4）" value="{{quality.evidence}}" options="{{quality4}}" data-key="quality.evidence" bindchange="input"/><rp-select disabled="{{busy}}" label="价值（0–3）" value="{{quality.value}}" options="{{quality3}}" data-key="quality.value" bindchange="input"/><textarea disabled="{{busy}}" placeholder="质量评分理由" value="{{quality.reason}}" data-key="quality.reason" bindinput="input" maxlength="1000"/><button bindtap="toggleSlower">{{slowerConfirmed ? '✓ 已确认成绩变慢' : '确认成绩变慢'}}</button><view class="actions"><button data-action="accept" disabled="{{!preview || busy}}" bindtap="review">采纳</button><button data-action="needs_info" bindtap="review">要求补充</button><button data-action="ignore" bindtap="review">不采纳</button><button data-action="reopen" bindtap="review">重新打开</button><button bindtap="rate">调整质量评分</button></view></view>
 <view wx:if="{{tab === 'feedback' && detail}}"><rp-select disabled="{{busy}}" label="处理状态" value="{{handleStatus}}" options="{{handleStatuses}}" data-key="handleStatus" bindchange="input"/><button bindtap="handle">回复并更新状态</button></view>
 <view wx:if="{{tab === 'accounts' && detail}}"><rp-select disabled="{{busy}}" label="账号操作" value="{{accountAction}}" options="{{accountActions}}" data-key="accountAction" bindchange="input"/><button bindtap="control">执行账号操作</button></view>
 <view wx:if="{{tab === 'invitations'}}" class="panel"><view class="heading">创建管理员邀请</view><input disabled="{{busy}}" placeholder="受邀邮箱" value="{{form.email}}" data-key="form.email" bindinput="input"/><input disabled="{{busy}}" placeholder="有效小时（1–168）" type="number" value="{{form.expires_hours}}" data-key="form.expires_hours" bindinput="input"/><button bindtap="invite">创建邀请</button><text wx:if="{{invitationCode}}" selectable="{{true}}" class="notice">邀请码：{{invitationCode}}</text></view>
 <view wx:if="{{tab === 'announcements'}}" class="panel"><view class="heading">公告编辑</view><input disabled="{{busy}}" placeholder="标题" value="{{form.title}}" data-key="form.title" bindinput="input" maxlength="120"/><input disabled="{{busy}}" placeholder="版本标签" value="{{form.release_label}}" data-key="form.release_label" bindinput="input" maxlength="80"/><textarea disabled="{{busy}}" placeholder="公告正文" value="{{form.body}}" data-key="form.body" bindinput="input" maxlength="6000"/><view class="actions"><button bindtap="saveAnnouncement">保存草稿</button><button wx:if="{{detail}}" data-action="publish" bindtap="announcementState">发布到当前隔离环境</button><button wx:if="{{detail}}" data-action="withdraw" bindtap="announcementState">撤回</button></view></view>
 <view wx:if="{{tab === 'versions'}}" class="panel"><button bindtap="prepare" disabled="{{!selected.length || busy}}">准备所选变更</button><button wx:for="{{batches}}" wx:key="id" data-id="{{item.id}}" bindtap="openBatch">{{item.id}} · {{item.state}}</button><view wx:if="{{batch}}"><view class="heading">批次 {{batch.state}}</view><view class="body muted">{{batch.base}} → {{batch.target}}</view><view class="error" wx:if="{{batch.stale_reasons.length}}">{{batch.stale_reasons}}</view><view class="item" wx:for="{{batchFacts}}" wx:key="label"><view class="muted">{{item.label}}</view><view class="body">{{item.value}}</view></view><view wx:for="{{approvals}}" wx:key="submission_id" class="panel"><view>{{item.submission_id}}</view><button data-index="{{index}}" data-key="confirmed" bindtap="approval">{{item.confirmed ? '✓ 已确认此项全部变更与镜像' : '确认此项全部变更与镜像'}}</button><button data-index="{{index}}" data-key="slower_confirmed" bindtap="approval">{{item.slower_confirmed ? '✓ 已确认变慢' : '确认变慢'}}</button><textarea disabled="{{busy}}" placeholder="变慢原因（需要时填写）" value="{{item.slower_reason}}" data-index="{{index}}" data-key="slower_reason" bindinput="approval" maxlength="2000"/></view><button bindtap="effects">{{effectsConfirmed ? '✓ 已阅读全部影响' : '确认已阅读全部影响'}}</button><view class="actions"><button bindtap="execute">应用隔离批次</button><button data-action="rollback" bindtap="batchAction">回滚此批次</button><button data-action="recover" bindtap="batchAction">核对并恢复此批次</button></view></view></view>
 <view wx:if="{{tab === 'usage'}}"><view class="item" wx:for="{{summaryFacts}}" wx:key="label"><view class="muted">{{item.label}}</view><view>{{item.value}}</view></view></view>
 <view wx:if="{{tab === 'feedback'}}" class="item" wx:for="{{feedbackSummary}}" wx:key="label">{{item.label}}：{{item.value}}</view><view wx:if="{{tab === 'activity' && detail}}" class="panel"><input disabled="{{busy}}" placeholder="开始日期 YYYY-MM-DD" value="{{activityStart}}" data-key="activityStart" bindinput="input"/><input disabled="{{busy}}" placeholder="结束日期 YYYY-MM-DD" value="{{activityEnd}}" data-key="activityEnd" bindinput="input"/><rp-select disabled="{{busy}}" label="服别" value="{{activityServer}}" options="{{activityServers}}" data-key="activityServer" bindchange="input"/><button data-delta="0" bindtap="activityPage">按日期查询</button><button data-delta="-1" bindtap="activityPage">前十条</button><button data-delta="1" bindtap="activityPage">后十条</button></view><view class="field-label">处理说明 / 操作原因</view><textarea disabled="{{busy}}" value="{{reason}}" data-key="reason" bindinput="input" maxlength="2000"/>
</view></view>
